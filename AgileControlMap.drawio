        <mxCell id="ceHBMdHGofH0zuc_rEOh-3" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO09.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Define and prepare service agreements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4707.5" y="3520" width="300" height="60" as="geometry">
            <mxRectangle x="4700" y="3920" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-4" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Define and prepare service agreements based on options in the service&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;catalogues. Include internal operational agreements.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that I&amp;amp;T products, services and service levels meet current and future enterprise needs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to design adequate service agreements with obtained service providers, in order to have a solid contractual foundation for future collaboration.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO09.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-3" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-5" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO09.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Catalog I&amp;amp;T-enabled services." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4347.5" y="3520" width="300" height="60" as="geometry">
            <mxRectangle x="4340" y="3920" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-6" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Define and maintain one or more service catalogues for relevant target&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;groups. Publish and maintain live I&amp;amp;T-enabled services in the service&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;catalogs.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that I&amp;amp;T products, services and service levels meet current and future enterprise needs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to register and maintain all obtained services, in order to have them documented for further controls.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO09.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-5" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-7" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO09.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Identify I&amp;amp;T services." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3987.5" y="3520" width="300" height="60" as="geometry">
            <mxRectangle x="3980" y="3920" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-8" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Analyze business requirements and the degree to which I&amp;amp;T-enabled&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;services and service levels support business processes. Discuss&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;and agree with the business on potential services and service levels.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Compare potential service levels against the current service portfolio;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;identify new or changed services or service level options.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that I&amp;amp;T products, services and service levels meet current and future enterprise needs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to identify all adapted or newly obtained services, in order to align them with business needs and appropriate service levels.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO09.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-7" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-9" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO09.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Monitor and report service levels." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5067.5" y="3520" width="300" height="60" as="geometry">
            <mxRectangle x="5060" y="3920" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-10" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;Monitor service levels, report on achievements and identify trends.&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;Provide the appropriate management information to aid performance&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;management.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that I&amp;amp;T products, services and service levels meet current and future enterprise needs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to establish within a project adequate monitoring mechanisms or monitor themselves in case of a DevOps approach, in order to identify deficient or flawed service quality in a timely manner.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO09.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-9" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-11" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO09.05&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Review service agreements and contracts." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5427.5" y="3520" width="300" height="60" as="geometry">
            <mxRectangle x="5420" y="3920" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-12" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Conduct periodic reviews of the service agreements and revise when&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;needed.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that I&amp;amp;T products, services and service levels meet current and future enterprise needs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to introduce new or adapted contracts in the periodic review process or review contracts themselves in case of a DevOps approach, in order to assure an adequate contractual basis.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-11" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
