          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-45" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="ceHBMdHGofH0zuc_rEOh-51" target="ceHBMdHGofH0zuc_rEOh-49" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4287.5" y="3780" as="sourcePoint" />
            <mxPoint x="4287.5" y="3730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-46" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="ceHBMdHGofH0zuc_rEOh-49" target="ceHBMdHGofH0zuc_rEOh-47" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4297.5" y="3790" as="sourcePoint" />
            <mxPoint x="4357.5" y="3790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-47" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO12.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Articulate risk." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4707.5" y="3780" width="300" height="60" as="geometry">
            <mxRectangle x="4707.5" y="4000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-48" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Communicate information on the current state of I&amp;amp;T-related exposures&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;and opportunities in a timely manner to all required stakeholders for&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;appropriate response.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Integrate the management of I&amp;amp;T-related enterprise risk with overall enterprise risk management (ERM) and balance the costs and benefits of&amp;nbsp;managing I&amp;amp;T-related enterprise risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to report the current risk situation to relevant stakeholders, in order to raise awareness on relevant managerial levels.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO12.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-47" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-49" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO12.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Maintain a risk profile." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4347.5" y="3780" width="300" height="60" as="geometry">
            <mxRectangle x="4347.5" y="4000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-50" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Maintain an inventory of known risk and risk attributes, including&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;expected frequency, potential impact and responses. Document related&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;resources, capabilities and current control activities related to risk items.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Integrate the management of I&amp;amp;T-related enterprise risk with overall enterprise risk management (ERM) and balance the costs and benefits of&amp;nbsp;managing I&amp;amp;T-related enterprise risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to maintain an inventory of risks and responses, in order to keep an overview and built upon in course of addressing the risks.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO12.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-49" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-51" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO12.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Analyze risk." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3987.5" y="3780" width="300" height="60" as="geometry">
            <mxRectangle x="3987.5" y="4000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-52" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop a substantiated view on actual I&amp;amp;T risk, in support of risk decisions.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Integrate the management of I&amp;amp;T-related enterprise risk with overall enterprise risk management (ERM) and balance the costs and benefits of&amp;nbsp;managing I&amp;amp;T-related enterprise risk.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to analyze the risk situation of their deliverables, in order to enable risk-based decisions.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO12.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-51" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-53" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO12.05&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Define a risk management action portfolio." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5067.5" y="3780" width="300" height="60" as="geometry">
            <mxRectangle x="5067.5" y="4000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-54" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;Manage opportunities to reduce risk to an acceptable level as a portfolio.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Integrate the management of I&amp;amp;T-related enterprise risk with overall enterprise risk management (ERM) and balance the costs and benefits of&amp;nbsp;managing I&amp;amp;T-related enterprise risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to consider risk reducing measures, in order to meet the enterprise&#39;s risk appetite.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO12.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-53" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-55" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO12.06&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Respond to risk." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5427.5" y="3780" width="300" height="60" as="geometry">
            <mxRectangle x="5427.5" y="4000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-56" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Respond in a timely manner to materialized risk events with effective&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;measures to limit the magnitude of loss.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Integrate the management of I&amp;amp;T-related enterprise risk with overall enterprise risk management (ERM) and balance the costs and benefits of&amp;nbsp;managing I&amp;amp;T-related enterprise risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to enable a timely response to materializing risk events, in order to reduce the impact of adverse events.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-55" vertex="1">
