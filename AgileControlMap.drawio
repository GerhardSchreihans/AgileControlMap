          <mxGeometry x="7992" y="1330" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="-aGxGEo2_JWixX-oLaSN-1" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Availability&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-style: normal; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20font-weight%3A%20400%3B%26quot%3B%26gt%3BKnowledge%20management%20(3.2.1)%26lt%3B%2Fi%26gt%3B%26lt%3Bbr%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%20Establishing%20and%20maintaining%20the%20knowledge%20management%20environment%22%20style%3D%22swimlane%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BstartSize%3D60%3BfillColor%3D%23E1D5E7%3BstrokeColor%3D%23A680B8%3B%22%20vertex%3D%221%22%20collapsed%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%225073%22%20y%3D%221990%22%20width%3D%22300%22%20height%3D%2260%22%20as%3D%22geometry%22%3E%3CmxRectangle%20x%3D%224713%22%20y%3D%221720%22%20width%3D%22360%22%20height%3D%22410%22%20as%3D%22alternateBounds%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%223%22%20value%3D%22%26lt%3Bb%26gt%3BControl%20Description%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Understand%20current%20culture%20of%20knowledge%20usage%20and%20knowledge%20sharing%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Review%20external%20and%20internal%20requirements%20and%20factors%20of%20influence%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Optimize%20response%2C%20identify%20improvements%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Promote%20and%20empower%20usage%20of%20knowledge%20management%20practice%20across%20the%20organization%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Review%20knowledge%20management%20practice%20application%20and%20initiate%20improvements%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bb%26gt%3BControl%20Objective%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3BThe%20purpose%20of%20the%20knowledge%20management%20practice%20is%20to%20maintain%20and%20improve%20the%20effective%2C%20efficient%2C%20and%20convenient%20use%20of%20information%20and%20knowledge%20across%20the%20organization.%26lt%3Bbr%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20background-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BEnabler%20Story%3A%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BAs%20management%20of%20the%20enterprise%2C%20want%20agile%20solution%20development%20projects%20to%20contribute%20to%20a%20well%20established%20knowledge%20management%20environment%2C%20in%20order%20to%20maintain%20solution%2Fproduct%2Fproject%20knowledge%20in%20a%20manner%20that%20fits%20to%20the%20enterprise.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3B%26lt%3Bu%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%26quot%3B%26gt%3BDirect%20Successor%26lt%3B%2Fu%26gt%3B%3A%20Knowledge%20management%20(3.2.2)%26lt%3B%2Ffont%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3B%22%20vertex%3D%221%22%20parent%3D%222%22%3E%3CmxGeometry%20y%3D%2260%22%20width%3D%22360%22%20height%3D%22350%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%224%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%26amp%3Bnbsp%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20font-weight%3A%20400%3B%26quot%3B%26gt%3BKnowledge%20management%20(3.2.2)%26lt%3B%2Fi%26gt%3B%26lt%3Bbr%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20On-demand%20information%20discovery%22%20style%3D%22swimlane%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BstartSize%3D60%3BfillColor%3D%23E1D5E7%3BstrokeColor%3D%23A680B8%3B%22%20vertex%3D%221%22%20collapsed%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%225433%22%20y%3D%221990%22%20width%3D%22300%22%20height%3D%2260%22%20as%3D%22geometry%22%3E%3CmxRectangle%20x%3D%225073%22%20y%3D%221720%22%20width%3D%22360%22%20height%3D%22410%22%20as%3D%22alternateBounds%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%225%22%20value%3D%22%26lt%3Bb%26gt%3BControl%20Description%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Registration%20of%20information%20request%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Research%20and%20data%20collection%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Information%20processing%20and%20presentation%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Information%20acceptance%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Knowledge%20integration%20and%20review%26lt%3B%2Fdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BControl%20Objective%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3BThe%20purpose%20of%20the%20knowledge%20management%20practice%20is%20to%20maintain%20and%20improve%20the%20effective%2C%20efficient%2C%20and%20convenient%20use%20of%20information%20and%20knowledge%20across%20the%20organization.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BEnabler%20Story%3A%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BAs%20management%20of%20the%20enterprise%2C%20I%20want%20agile%20solution%20development%20projects%20to%20follow%20and%20apply%20on-demand%20information%20discovery%20processes%20to%20be%20established%2C%20in%20order%20to%20explore%20and%20research%20new%20information%20in%20an%20adequate%20quality.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3B%26lt%3Bu%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%26quot%3B%26gt%3BDirect%20Successor%26lt%3B%2Fu%26gt%3B%3A%26amp%3Bnbsp%3B%26lt%3B%2Ffont%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3BKnowledge%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3Bmanagement%20(3.2.3)%26lt%3B%2Fspan%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3B%22%20vertex%3D%221%22%20parent%3D%224%22%3E%3CmxGeometry%20y%3D%2260%22%20width%3D%22360%22%20height%3D%22350%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%226%22%20value%3D%22%22%20style%3D%22endArrow%3Dclassic%3Bhtml%3D1%3Brounded%3D0%3BentryX%3D0%3BentryY%3D0%3BentryDx%3D0%3BentryDy%3D0%3BexitX%3D1%3BexitY%3D0%3BexitDx%3D0%3BexitDy%3D0%3B%22%20edge%3D%221%22%20source%3D%222%22%20target%3D%224%22%20parent%3D%221%22%3E%3CmxGeometry%20width%3D%2250%22%20height%3D%2250%22%20relative%3D%221%22%20as%3D%22geometry%22%3E%3CmxPoint%20x%3D%225023%22%20y%3D%222000%22%20as%3D%22sourcePoint%22%2F%3E%3CmxPoint%20x%3D%225083%22%20y%3D%222000%22%20as%3D%22targetPoint%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-style: normal; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26