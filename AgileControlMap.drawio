        <mxCell id="pFyAgszVoUyKk6v15XwR-2" value="&lt;font style=&quot;font-size: 80px;&quot;&gt;&lt;font color=&quot;#ababab&quot;&gt;&lt;b style=&quot;&quot;&gt;Requirements to consider &lt;i&gt;&lt;u&gt;after&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;color: rgb(171, 171, 171); background-color: initial;&quot;&gt;&amp;nbsp;implementation of an artifact&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="11880" y="608" width="5850" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pFyAgszVoUyKk6v15XwR-3" value="&lt;font color=&quot;#ababab&quot;&gt;&lt;span style=&quot;font-size: 80px;&quot;&gt;&lt;b&gt;Artifacts&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="8960" y="608" width="2780" height="140" as="geometry" />
        </mxCell>
        <mxCell id="DO11c-6wLbNFiMZy8dLW-25" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Software Development and Management&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&amp;nbsp;(3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Software development and management" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4980.5" y="6719" width="300" height="60" as="geometry">
            <mxRectangle x="5431.75" y="8630" width="360" height="490" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DO11c-6wLbNFiMZy8dLW-26" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Product planning and prioritization&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Software design&lt;/div&gt;&lt;div&gt;- New code production&lt;/div&gt;&lt;div&gt;- Code review&lt;/div&gt;&lt;div&gt;- Defect handling&lt;/div&gt;&lt;div&gt;- Technical debt management&lt;/div&gt;&lt;div&gt;- Code refactoring&lt;/div&gt;&lt;div&gt;- Research and Development&lt;/div&gt;&lt;div&gt;- Regular meetings and improvement activities&lt;/div&gt;&lt;div&gt;- Software operation and maintenance automation&lt;/div&gt;&lt;div&gt;- Managing development environments&lt;/div&gt;&lt;div&gt;- Version Control&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the software development and management practice is to ensure that applications meet internal and external stakeholders needs, in terms of functionality, reliability, maintainability, compliance, and auditability.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to maintain and follow a solid software development practice, in order to keep a sufficient code and overall software quality.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="DO11c-6wLbNFiMZy8dLW-25" vertex="1">
          <mxGeometry y="60" width="360" height="430" as="geometry" />
        </mxCell>
        <mxCell id="iMIV0qhzkyAP3cC0WdMi-5" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ISO 27001 &amp;amp; 27002 - 5.25&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Assessment and decision on information security events" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5395.5" y="6718" width="300" height="60" as="geometry">
            <mxRectangle x="5428.75" y="13440" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iMIV0qhzkyAP3cC0WdMi-6" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;The organization should assess information security events and decide if they are to be categorized as information security incidents.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;To ensure effective categorization and prioritization of information security events.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to onboard their solutions to the enterprise&#39;s information security event management process, in order to assure a proper handling of information security events concerning the newly developed solution.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="iMIV0qhzkyAP3cC0WdMi-5" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="3NLvPx2ckS6_KmLze-8x-11" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ISO 27001 &amp;amp; 27002 - 8.26&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;Application security requirements" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5757.25" y="6718" width="300" height="60" as="geometry">
            <mxRectangle x="5434.25" y="16730" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3NLvPx2ckS6_KmLze-8x-12" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Information security requirements should be identified, specified and approved when developing or&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;acquiring applications.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;To ensure all information security requirements are identified and addressed when developing or&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;acquiring applications.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to identify, approve and adhere information security requirements, in order to ensure all information security requirements are identified and addressed when developing or acquiring applications.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="3NLvPx2ckS6_KmLze-8x-11" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="DO11c-6wLbNFiMZy8dLW-18" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Infrastructure and Platform M&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-style: normal; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20font-weight%3A%20400%3B%26quot%3B%26gt%3BKnowledge%20management%20(3.2.1)%26lt%3B%2Fi%26gt%3B%26lt%3Bbr%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%20Establishing%20and%20maintaining%20the%20knowledge%20management%20environment%22%20style%3D%22swimlane%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BstartSize%3D60%3BfillColor%3D%23E1D5E7%3BstrokeColor%3D%23A680B8%3B%22%20vertex%3D%221%22%20collapsed%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%225073%22%20y%3D%221990%22%20width%3D%22300%22%20height%3D%2260%22%20as%3D%22geometry%22%3E%3CmxRectangle%20x%3D%224713%22%20y%3D%221720%22%20width%3D%22360%22%20height%3D%22410%22%20as%3D%22alternateBounds%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%223%22%20value%3D%22%26lt%3Bb%26gt%3BControl%20Description%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Understand%20current%20culture%20of%20knowledge%20usage%20and%20knowledge%20sharing%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Review%20external%20and%20internal%20requirements%20and%20factors%20of%20influence%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Optimize%20response%2C%20identify%20improvements%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Promote%20and%20empower%20usage%20of%20knowledge%20management%20practice%20across%20the%20organization%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Review%20knowledge%20management%20practice%20application%20and%20initiate%20improvements%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bb%26gt%3BControl%20Objective%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3BThe%20purpose%20of%20the%20knowledge%20management%20practice%20is%20to%20maintain%20and%20improve%20the%20effective%2C%20efficient%2C%20and%20convenient%20use%20of%20information%20and%20knowledge%20across%20the%20organization.%26lt%3Bbr%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20background-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BEnabler%20Story%3A%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BAs%20management%20of%20the%20enterprise%2C%20want%20agile%20solution%20development%20projects%20to%20contribute%20to%20a%20well%20established%20knowledge%20management%20environment%2C%20in%20order%20to%20maintain%20solution%2Fproduct%2Fproject%20knowledge%20in%20a%20manner%20that%20fits%20to%20the%20enterprise.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3B%26lt%3Bu%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%26quot%3B%26gt%3BDirect%20Successor%26lt%3B%2Fu%26gt%3B%3A%20Knowledge%20management%20(3.2.2)%26lt%3B%2Ffont%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3B%22%20vertex%3D%221%22%20parent%3D%222%22%3E%3CmxGeometry%20y%3D%2260%22%20width%3D%22360%22%20height%3D%22350%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%224%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%26amp%3Bnbsp%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-weight