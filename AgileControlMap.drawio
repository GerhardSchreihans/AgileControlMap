        <mxCell id="pFyAgszVoUyKk6v15XwR-1" value="&lt;font style=&quot;font-size: 80px;&quot;&gt;&lt;font color=&quot;#ababab&quot;&gt;&lt;b style=&quot;&quot;&gt;Requirements to consider &lt;i style=&quot;text-decoration-line: underline;&quot;&gt;before&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;color: rgb(171, 171, 171); background-color: initial;&quot;&gt;&amp;nbsp;implementation of an artifact&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="270" y="608" width="8550" height="140" as="geometry" />
