        <mxCell id="ceHBMdHGofH0zuc_rEOh-70" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO14.08&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage the life cycle of data assets." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4707.5" y="3960" width="300" height="60" as="geometry">
            <mxRectangle x="4707.5" y="4180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-71" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Ensure that the organization understands, maps, inventories and controls&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;its data flows through business processes over the data life cycle, from&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;creation or acquisition to retirement.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure effective utilization of the critical data assets to achieve enterprise goals and objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to consider the data life cycle of processed data, in order to maintain data from creation, acquisition to retirement.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO14.09&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-70" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-72" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO14.07&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Define the data cleansing approach." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4347.5" y="3960" width="300" height="60" as="geometry">
            <mxRectangle x="4347.5" y="4180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-73" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Define the mechanisms, rules, processes, and methods to validate and&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;correct data according to predefined business rules.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure effective utilization of the critical data assets to achieve enterprise goals and objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to consider mechanisms, rules, processes and methods to correct data, in order to keep just correct data and remain compliant to data privacy laws.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO14.08&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-72" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-74" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO14.09&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Support data archiving and retention." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5067.5" y="3960" width="300" height="60" as="geometry">
            <mxRectangle x="5067.5" y="4180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-75" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;Ensure that data maintenance satisfies organizational and regulatory&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;requirements for availability of historical data. Ensure that legal and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;regulatory requirements for data archiving and retention are met.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure effective utilization of the critical data assets to achieve enterprise goals and objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to establish data archiving and retention mechanisms, in order to hold historical data available and ensure legal and regulatory requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO14.10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-74" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-76" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO14.10&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage data backup and restore arrangements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5427.5" y="3960" width="300" height="60" as="geometry">
            <mxRectangle x="5427.5" y="4180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-77" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Manage availability of critical data to ensure operational continuity.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure effective utilization of the critical data assets to achieve enterprise goals and objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to backup data and keep backups available, in order to remain operational.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ceHBMdHGofH0zuc_rEOh-76" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-78" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="ceHBMdHGofH0zuc_rEOh-70" target="ceHBMdHGofH0zuc_rEOh-74" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5007.5" y="3960" as="sourcePoint" />
            <mxPoint x="5067.5" y="3960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-79" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="ceHBMdHGofH0zuc_rEOh-74" target="ceHBMdHGofH0zuc_rEOh-76" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5017.5" y="3970" as="sourcePoint" />
            <mxPoint x="5077.5" y="3970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ceHBMdHGofH0zuc_rEOh-80" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="ceHBMdHGofH0zuc_rEOh-76" target="FFkF1W79zcPs98VZCzmz-2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5738" y="4100" as="sourcePoint" />
            <mxPoint x="6025" y="3560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-1" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-4" target="5n0gASPAGLLi4WL7JSeG-2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2860" y="2320" as="sourcePoint" />
            <mxPoint x="2920" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-2" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI01.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Initiate a program." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="3270" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="2902.5" y="2970" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-3" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Initiate a program to confirm expected benefits and obtain authorization to proceed. This includes agreeing on program sponsorship, confirming the program mandate through approval of the conceptual business case, appointing program board or committee members, producing the program brief, reviewing and updating the business case, developing a benefits realization plan, and obtaining approval from sponsors to proceed.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a clear initiation of a program, in order to assign clear roles and establish a solid framework.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-2">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-4" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - BAI01.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Maintain a standard approach for program management." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="2910" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="2542.5" y="2970" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-5" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Maintain a standard approach for program management that enables governance and management review, decision-making and delivery management activities. These activities should focus consistently on business value and goals (i.e., requirements, risk, costs, schedule and quality targets).&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want even agile solution development projects to follow a standardized and homogeneous approach, in order to assure a certain quality and control mechanisms.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-4">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-6" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI01.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage stakeholder engagement." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="3630" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="3262.5" y="2970" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-7" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Manage stakeholder engagement to ensure an active exchange of accurate, consistent and timely information for all relevant stakeholders. This includes planning, identifying and engaging stakeholders and managing their expectations.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want stakeholders to be involved, in order to assure that the deliverables meet their requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-6">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-8" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI01.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Develop and maintain the program plan." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="3990" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="3622.5" y="2970" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-9" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Formulate a program to lay the initial groundwork. Position it for successful execution by formalizing the scope of the work and identifying deliverables that will satisfy goals and deliver value. Maintain and update the program plan and business case throughout the full economic life cycle of the program, ensuring alignment with strategic objectives and reflecting the current status and insights gained to date.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to have a maintained program plan, in order to ensure an alignment with strategic objectives and get an understanding of the project schedule.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-8">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-10" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-2" target="5n0gASPAGLLi4WL7JSeG-6">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3570" y="2310" as="sourcePoint" />
            <mxPoint x="3630" y="2310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-11" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-6" target="5n0gASPAGLLi4WL7JSeG-8">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3580" y="2320" as="sourcePoint" />
            <mxPoint x="3640" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-12" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-15" target="5n0gASPAGLLi4WL7JSeG-13">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4660" y="2320" as="sourcePoint" />
            <mxPoint x="4720" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-13" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI01.07&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage program quality." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5070" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="4702.5" y="2970" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-14" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Prepare and execute a quality management plan, processes and practices that align with quality management standards (QMS). Describe the approach to program quality and implementation. The plan should be formally reviewed and agreed on by all parties concerned and incorporated into the integrated program plan.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to have a quality management plan executed, in order to align the program with quality management standards.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.08&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-13">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-15" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI01.06&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Monitor, control and report on the program outcomes." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4710" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="4342.5" y="2970" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-16" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Monitor and control performance against plan throughout the full economic life cycle of the investment, covering solution delivery at the program level and value/outcome at the enterprise level. Report performance to the program steering committee and the sponsors&lt;span style=&quot;background-color: initial;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want programs to be monitored, controlled and reported, in order to assure an adequate quality and maintain a necessary oversight on the program.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.07&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-15">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-17" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI01.08&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage program risk." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="2310" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-18" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Eliminate or minimize specific risk associated with programs through a systematic process of planning, identifying, analyzing, responding to, monitoring and controlling the areas or events with the potential to cause unwanted change. Define and record any risk faced by program management.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want risks to be managed, in order to assure the anticipation of adverse events and the maintenance of counter measures.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.09&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-17">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-19" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.05&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Close a program." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="6547.5" y="1560" width="300" height="60" as="geometry">
            <mxRectangle x="6470" y="2210" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-20" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Remove the program from the active investment portfolio when there is agreement that the desired value has been achieved or when it is clear it will not be achieved within the value criteria set for the program.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want programs to be closed, in order to maintain an up-to-date investment portfolio.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-19">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-21" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-13" target="5n0gASPAGLLi4WL7JSeG-17">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5370" y="2310" as="sourcePoint" />
            <mxPoint x="5430" y="2310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-22" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="VOTrehMlLt_2pqgxl_0n-1" target="5n0gASPAGLLi4WL7JSeG-19">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5020" y="2320" as="sourcePoint" />
            <mxPoint x="5080" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-23" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI01.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Launch and execute the program." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4350" y="2310" width="300" height="60" as="geometry">
            <mxRectangle x="3982.5" y="2970" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-24" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Launch and execute the program to acquire and direct the resources needed to accomplish the goals and benefits of the program as defined in the program plan. In accordance with stage-gate or release review criteria, prepare for stage-gate, iteration or release reviews to report progress and make the case for funding up to the following stage-gate or release review.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize desired business value and reduce the risk of unexpected delays, costs and value erosion. To do so, improve communications to and involvement of business and end users, ensure the value and quality of program deliverables and follow up of projects within the programs, and maximize program contribution to the investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the program to acquire and resources, in order to accomplish the goals and benefits of the program as defined.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI01.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-23">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-25" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-8" target="5n0gASPAGLLi4WL7JSeG-23">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3940.5" y="2320" as="sourcePoint" />
            <mxPoint x="4000.5" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-26" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-23" target="5n0gASPAGLLi4WL7JSeG-15">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4300.5" y="2320" as="sourcePoint" />
            <mxPoint x="4360.5" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-27" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-17" target="VOTrehMlLt_2pqgxl_0n-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5380.5" y="2320" as="sourcePoint" />
            <mxPoint x="5440.5" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-39" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-42" target="5n0gASPAGLLi4WL7JSeG-40">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4660" y="4620" as="sourcePoint" />
            <mxPoint x="4720" y="4620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-40" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI02.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage requirements risk." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5070" y="4610" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="4610" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-41" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Identify, document, prioritize and mitigate functional, technical and information processing-related risk associated with the enterprise requirements, assumptions and proposed solution.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Create optimal solutions that meet enterprise needs while minimizing risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want risks associated with requirements to be evaluated, in order to be able to address them.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI02.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-40">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-42" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI02.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Perform a feasibility study and formulate alternative solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4710" y="4610" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4610" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-43" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Perform a feasibility study of potential alternative solutions, assess their viability and select the preferred option. If appropriate, implement the selected option as a pilot to determine possible improvements.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Create optimal solutions that meet enterprise needs while minimizing risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want feasibility studies to be performed and alternative solutions to be evaluated, in order to identify optimal solutions and assess different options.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI02.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-42">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-44" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI02.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Obtain approval of requirements and solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="4610" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4610" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-45" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Coordinate feedback from affected stakeholders. At predetermined key stages, obtain approval and sign-off from the business sponsor or product owner regarding functional and technical requirements, feasibility studies, risk analyses and recommended solutions.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Create optimal solutions that meet enterprise needs while minimizing risk.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to obtain feedback from affected stakeholders and a sign-off on the requirements and solution, in order to create liability and document agreements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-44">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-46" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-40" target="5n0gASPAGLLi4WL7JSeG-44">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5370" y="4610" as="sourcePoint" />
            <mxPoint x="5430" y="4610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-47" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI02.01&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;Define and maintain business functional and technical&lt;div&gt;requirements.&lt;/div&gt;" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4350" y="4610" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="4610" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-48" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Based on the business case, identify, prioritize, specify and agree on business information, functional, technical and control requirements covering the scope/understanding of all initiatives required to achieve the expected outcomes of the proposed I&amp;amp;T-enabled business solution.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Create optimal solutions that meet enterprise needs while minimizing risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want business function and technical requirements to be defined, in order for the project to be able to develop deliverables in line with these requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI02.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-47">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-49" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-47" target="5n0gASPAGLLi4WL7JSeG-42">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4300.5" y="4620" as="sourcePoint" />
            <mxPoint x="4360.5" y="4620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-50" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-44" target="FFkF1W79zcPs98VZCzmz-3">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5380" y="4620" as="sourcePoint" />
            <mxPoint x="5440" y="4620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-52" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-55" target="VOTrehMlLt_2pqgxl_0n-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5380" y="2410" as="sourcePoint" />
            <mxPoint x="5790" y="2400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-53" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Design detailed solution components." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="2187.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="1827.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-54" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop, document and elaborate detailed designs progressively. Use agreed and appropriate phased or rapid Agile development techniques, addressing all components (business processes and related automated and manual controls, supporting I&amp;amp;T applications, infrastructure services and technology products, and partners/suppliers). Ensure that the detailed design includes internal and external service level agreements (SLAs) and operational level agreements (OLAs).&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solution components to be developed, documented and elaborated in a detailed manner, in order to to develop a diligently planned solution.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-53">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-55" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - BAI03.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Design high-level solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="2400" width="300" height="60" as="geometry">
            <mxRectangle x="1467.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-56" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop and document high-level designs for the solution in terms of technology, business processes and workflows. Use agreed and appropriate phased or rapid Agile development techniques. Ensure alignment with the I&amp;amp;T strategy and enterprise architecture. Reassess and update the designs when significant issues occur during detailed design or building phases, or as the solution evolves. Apply a user-centric approach; ensure that stakeholders actively participate in the design and approve each version.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a high-level solution to be designed, in order to involve all necessary counterparties as well as align on a common setting.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-55">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-57" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Develop solution components." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="2547.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="2187.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-58" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Develop solution components progressively in a separate environment, in accordance with detailed designs following standards and requirements for development and documentation, quality assurance (QA), and approval. Ensure that all control requirements in the business processes, supporting I&amp;amp;T applications and infrastructure services, services and technology products, and partner/vendor services are addressed.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solution components to be orderly developed, in order an appropriate quality in alignment with the business requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-57">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-59" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Procure solution components." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="2907.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="2547.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-60" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Procure solution components, based on the acquisition plan, in accordance with requirements and detailed designs, architecture principles and standards, and the enterprise’s overall procurement and contract procedures, QA requirements, and approval standards. Ensure that all legal and contractual requirements are identified and addressed by the vendor.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the procurement of solution components to be diligently performed in accordance with requirements, in order to ensure that standards are met, quality is achieved and contractual requirements are met.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-59">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-61" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-53" target="5n0gASPAGLLi4WL7JSeG-57">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2487.5" y="4050" as="sourcePoint" />
            <mxPoint x="2547.5" y="4050" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-62" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-57" target="5n0gASPAGLLi4WL7JSeG-59">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2497.5" y="4060" as="sourcePoint" />
            <mxPoint x="2557.5" y="4060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-63" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-66" target="5n0gASPAGLLi4WL7JSeG-64">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3577.5" y="4060" as="sourcePoint" />
            <mxPoint x="3637.5" y="4060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-64" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.07&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Prepare for solution testing." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="3987.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="3627.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-65" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Establish a test plan and required environments to test the individual and integrated solution components. Include the business processes and supporting services, applications and infrastructure.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want testing of solutions to be diligently prepared, in order to assure effective testing.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.08&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-64">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-66" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.06&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Perform quality assurance (QA)." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="3627.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="3270" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-67" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop, resource and execute a QA plan aligned with the QMS to obtain the quality specified in the requirements definition and in the enterprise’s quality policies and procedures.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a solid QA plan to be executed, in order to meet the enterprise&#39;s quality standards.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.07&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-66">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-68" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.08&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Execute solution testing." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="6547.5" y="3320" width="300" height="60" as="geometry">
            <mxRectangle x="6430" y="3440" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-69" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;During development, execute testing continually (including control testing), in accordance with the defined test plan and development practices in the appropriate environment. Engage business process owners and end users in the test team. Identify, log and prioritize errors and issues identified during testing.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solutions to be diligently tested, in order to identify deficiencies before releasing them in production.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.09&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-68">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-70" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-64" target="5n0gASPAGLLi4WL7JSeG-83">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3927.5" y="4050" as="sourcePoint" />
            <mxPoint x="3987.5" y="4050" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-71" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Build solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="3267.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="2907.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-72" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Install and configure solutions and integrate with business process activities. During configuration and integration of hardware and infrastructure software, implement control, security, privacy and auditability measures to protect resources and ensure availability and data integrity. Update the product or services catalogue to reflect the new solutions.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a well configured solution integrated with business process, in order to met - among others - confidentiality, privacy, integrity and availability requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-71">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-73" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-59" target="5n0gASPAGLLi4WL7JSeG-71">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2858" y="4060" as="sourcePoint" />
            <mxPoint x="2918" y="4060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-74" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-71" target="5n0gASPAGLLi4WL7JSeG-66">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3218" y="4060" as="sourcePoint" />
            <mxPoint x="3278" y="4060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-75" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-78" target="5n0gASPAGLLi4WL7JSeG-76">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4657.5" y="4060" as="sourcePoint" />
            <mxPoint x="4717.5" y="4060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-76" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.11&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Define IT products and services and maintain the service portfolio." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5067.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-77" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Define and agree on new or changed IT products or services and service level options. Document new or changed product and service definitions and service level options to be updated in the products and services portfolio.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to have a clear oversight of current IT services and IT products, in order to keep an overview of the current IT landscape.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.12&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-76">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-78" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.10&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Maintain solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4707.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-79" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop and execute a plan for the maintenance of solution and infrastructure components. Include periodic reviews against business needs and operational requirements.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want developed solutions to be adequately maintained on a continuous basis, in order to assure a sustainable quality.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.11&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-78">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-80" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.12&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Design solutions based on the defined development methodology." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5427.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-81" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Design, develop and implement solutions with the appropriate development methodology (i.e., waterfall, Agile or bimodal I&amp;amp;T), in accordance with the overall strategy and requirements.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solutions to be developed with an appropriate development methodology in line with the overall strategy and requirements, in order to assure an unified procedure and appropriate quality.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-80">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-82" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-76" target="5n0gASPAGLLi4WL7JSeG-80">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5367.5" y="4050" as="sourcePoint" />
            <mxPoint x="5427.5" y="4050" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-83" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.09&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Manage changes to requirements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4347.5" y="4050" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-84" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Track the status of individual requirements (including all rejected requirements) throughout the project life cycle. Manage the approval of changes to requirements.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want changes to requirements and their approval to be sufficiently tracked, in order to maintain sufficient oversight of requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-83">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-85" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-83" target="5n0gASPAGLLi4WL7JSeG-78">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4298" y="4060" as="sourcePoint" />
            <mxPoint x="4358" y="4060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-86" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-80" target="FFkF1W79zcPs98VZCzmz-2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5737" y="3970" as="sourcePoint" />
            <mxPoint x="6025" y="3560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-87" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="FFkF1W79zcPs98VZCzmz-2" target="5n0gASPAGLLi4WL7JSeG-68">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="6330" y="1960" as="sourcePoint" />
            <mxPoint x="6558" y="1570" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-88" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-91" target="5n0gASPAGLLi4WL7JSeG-89">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4660" y="4150" as="sourcePoint" />
            <mxPoint x="4720" y="4150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-89" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Monitor and review availability and capacity." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5070" y="4140" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="4140" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-90" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Monitor, measure, analyze, report and review availability, performance and capacity. Identify deviations from established baselines. Review trend analysis reports identifying any significant issues and variances. Initiate actions where necessary and ensure that all outstanding issues are addressed.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want new solutions to be onboarded to the monitoring process as early as possible, in order to identify deviations from established baselines and enable the availability, capacity and performance management process to initiate actions.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI04.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-89">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-91" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Plan for new or changed service requirements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4710" y="4140" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4140" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-92" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Plan and prioritize availability, performance and capacity implications of changing business needs and service requirements.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want changing business needs and service requirements related to availability, performance an capacity to be considered in agile solution development projects, in order to address or at least consider them in course of development.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI04.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-91">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-93" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;Investigate and address availability, performance and&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;capacity issues.&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="4140" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4140" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-94" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Address deviations by investigating and resolving identified availability, performance and capacity issues.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to be aware that issues regarding availability, performance or capacity management in relation to their solution might have to be addressed by them in course of the project work, in order to assure the required level of availability, performance and capacity.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-93">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-95" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-89" target="5n0gASPAGLLi4WL7JSeG-93">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5370" y="4140" as="sourcePoint" />
            <mxPoint x="5430" y="4140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-96" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Assess business impact." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4350" y="4140" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="4140" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-97" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Identify important services to the enterprise. Map services and resources to business processes and identify business dependencies. Ensure that the impact of unavailable resources is fully agreed on and accepted by the customer. For vital business functions, ensure that availability requirements can be satisfied per service level agreement (SLA).&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want newly implemented services and resources to be mapped to business processes, in order to configure new solutions according to the business needs.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI04.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-96">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-98" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-96" target="5n0gASPAGLLi4WL7JSeG-91">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4300.5" y="4150" as="sourcePoint" />
            <mxPoint x="4360.5" y="4150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-99" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-93" target="FFkF1W79zcPs98VZCzmz-2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5738" y="4060" as="sourcePoint" />
            <mxPoint x="6025" y="3560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-100" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-103" target="5n0gASPAGLLi4WL7JSeG-101">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4300" y="2500" as="sourcePoint" />
            <mxPoint x="4360" y="2500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-101" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Form an effective implementation team." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4710" y="2490" width="300" height="60" as="geometry">
            <mxRectangle x="3630" y="4230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-102" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Establish an effective implementation team by assembling appropriate members, creating trust, and establishing common goals and effectiveness measures.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to form and assemble effective implementation teams, in order to create trust, establish common goals and develop effective measures.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI05.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-101">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-103" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.01&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Establish the desire to change." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4350" y="2490" width="300" height="60" as="geometry">
            <mxRectangle x="3270" y="4230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-104" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Understand the scope and impact of the desired change. Assess stakeholder readiness and willingness to change. Identify actions that will motivate stakeholder acceptance and participation to make the change work successfully.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile projects to assess the stakeholder&#39;s readiness and willingness to change, in order to establish a desire to change.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI05.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-103">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-105" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-101" target="5n0gASPAGLLi4WL7JSeG-114">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4650" y="2490" as="sourcePoint" />
            <mxPoint x="4710" y="2490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-106" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-109" target="VOTrehMlLt_2pqgxl_0n-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4300" y="4240" as="sourcePoint" />
            <mxPoint x="4360" y="4240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-107" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Enable operation and use." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="4230" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-108" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Plan and implement all technical, operational and usage aspects so all those who are involved in the future state environment can exercise their responsibility.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want operations to be already planned in the development phase, in order to assure a solid operation from day 1.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI05.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-107">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-109" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Empower role players and identify short-term wins." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="2490" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="2490" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-110" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Empower those with implementation roles by assigning accountability. Provide training and align organizational structures and HR processes. Identify and communicate short-term wins that are important from a change-enablement perspective.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want role models to be empowered and identify short-term wins, in order to drive the change and stuff it with resources.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI05.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-109">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-111" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.06&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Embed new approaches." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="6547.5" y="3410" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="4230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-112" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Embed new approaches by tracking implemented changes, assessing the effectiveness of the operation and use plan, and sustaining ongoing awareness through regular communication. Take corrective measures as appropriate (which may include enforcing compliance).&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want implemented changes to be tracked and new approaches to be embedded, in order to assure effective operations and sustainable management.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-111">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-113" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-107" target="FFkF1W79zcPs98VZCzmz-2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5010" y="4230" as="sourcePoint" />
            <mxPoint x="5070" y="4230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-114" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Communicate desired vision." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5070" y="2490" width="300" height="60" as="geometry">
            <mxRectangle x="3990" y="4230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-115" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Communicate the desired vision for the change in the language of those affected by it. The communication should be made by senior management and include the rationale for, and benefits of, the change; the impacts of not making the change; and the vision, the road map and the involvement required of the various stakeholders.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development project to communicate and promote the desired vision, in order to establish a desire to change with the stakeholders.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI05.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-114">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-116" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-114" target="5n0gASPAGLLi4WL7JSeG-109">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5020.5" y="2500" as="sourcePoint" />
            <mxPoint x="5080.5" y="2500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-117" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.07&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Sustain changes." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="6907.5" y="3410" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-118" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Sustain changes through effective training of new staff, ongoing communication campaigns, continued commitment of top management, monitoring of adoption and sharing of lessons learned across the enterprise.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want effective training and communication measures to be developed, in order to sustain changes.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-117">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-119" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-111" target="5n0gASPAGLLi4WL7JSeG-117">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="6497.5" y="3420" as="sourcePoint" />
            <mxPoint x="6557.5" y="3420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-120" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="FFkF1W79zcPs98VZCzmz-2" target="5n0gASPAGLLi4WL7JSeG-111">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="6020" y="4290" as="sourcePoint" />
            <mxPoint x="6305" y="3610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-121" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-124" target="5n0gASPAGLLi4WL7JSeG-122">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5020" y="4710" as="sourcePoint" />
            <mxPoint x="5080" y="4710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-122" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI06.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Track and report change status." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="4700" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="4700" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-123" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Maintain a tracking and reporting system to document rejected changes and communicate the status of approved, in-process and complete changes. Make certain that approved changes are implemented as planned.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Enable fast and reliable delivery of change to the business. Mitigate the risk of negatively impacting the stability or integrity of the changed environment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I agile solution development projects to track and report the status of their changes diligently, in order for the operational IT management to maintain oversight.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI06.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-122">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-124" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI06.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage emergency changes." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5070" y="4700" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4700" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-125" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Carefully manage emergency changes to minimize further incidents. Ensure the emergency change is controlled and takes place securely. Verify that emergency changes are appropriately assessed and authorized after the change.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Enable fast and reliable delivery of change to the business. Mitigate the risk of negatively impacting the stability or integrity of the changed environment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I agile solution development project - particularly if they are organized in a DevOps setup - to register emergency changes according to the enterprises process, in order to effectively manage incidents and document time-sensitive changes.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI06.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-124">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-126" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI06.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Close and document the changes." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="6547.5" y="4610" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4700" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-127" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;Whenever changes are implemented, update the solution, user&lt;/div&gt;&lt;div&gt;documentation and procedures affected by the change.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Create optimal solutions that meet enterprise needs while minimizing risk.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to update the solution as well as documentation and procedures affected by the change, in order to assure a stable IT operation.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-126">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-128" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-122" target="FFkF1W79zcPs98VZCzmz-3">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5370" y="4700" as="sourcePoint" />
            <mxPoint x="5430" y="4700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-129" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI06.01&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Evaluate, prioritize and authorize change requests." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4710" y="4700" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="4700" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-130" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Evaluate all requests for change to determine the impact on business processes and I&amp;amp;T services, and to assess whether change will adversely affect the operational environment and introduce unacceptable risk. Ensure that changes are logged, prioritized, categorized, assessed, authorized, planned and scheduled.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Enable fast and reliable delivery of change to the business. Mitigate the risk of negatively impacting the stability or integrity of the changed environment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want all IT changes impacting business processes and IT services to be evaluated, prioritized and authorized, in order to anticipate and prepare for adverse effects.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI06.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-129">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-131" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-129" target="5n0gASPAGLLi4WL7JSeG-124">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4660.5" y="4710" as="sourcePoint" />
            <mxPoint x="4720.5" y="4710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-132" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="FFkF1W79zcPs98VZCzmz-3" target="5n0gASPAGLLi4WL7JSeG-126">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5740" y="4620" as="sourcePoint" />
            <mxPoint x="6053" y="4720" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-133" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.01&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Establish an implementation plan." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4710" y="4790" width="300" height="60" as="geometry">
            <mxRectangle x="2910" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-134" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Establish an implementation plan that covers system and data conversion, acceptance testing criteria, communication, training, release preparation, promotion to production, early production support, a fallback/back-up plan, and a post-implementation review. Obtain approval from relevant parties.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want an implementation plan to be developed for all IT changes, in order to assure a smooth transition and release.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-133">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-135" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-138" target="FFkF1W79zcPs98VZCzmz-3">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5380" y="4800" as="sourcePoint" />
            <mxPoint x="6120" y="4750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-136" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Establish a test environment." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="4320" width="300" height="60" as="geometry">
            <mxRectangle x="3990" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-137" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Define and establish a secure test environment representative of the planned business process and IT operations environment in terms of performance, capacity, security, internal controls, operational practices, data quality, privacy requirements and workloads.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to have for each agile solution development project a representative testing environment set up that reflects the future production conditions, in order to perform tests that are representative for the future operational processes.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-136">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-138" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Plan acceptance tests." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5430" y="4790" width="300" height="60" as="geometry">
            <mxRectangle x="3630" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-139" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Establish a test plan based on enterprisewide standards that define roles, responsibilities, and entry and exit criteria. Ensure that the plan is approved by relevant parties.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want all IT changes to be tested according to a test plan that follows enterprise standards, in order to meet the necessary quality criteria.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-138">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-140" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-136" target="FFkF1W79zcPs98VZCzmz-2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3930" y="4790" as="sourcePoint" />
            <mxPoint x="3990" y="4790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-141" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Plan business process, system and data conversion." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5070" y="4790" width="300" height="60" as="geometry">
            <mxRectangle x="3270" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-142" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Prepare for business process, I&amp;amp;T service data and infrastructure migration as part of the enterprise’s development methods. Include audit trails and a recovery plan should the migration fail.&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to consider not just the IT parameter but also the effects on the business processes, data and infrastructure, in order to ensure also a smooth transition in the affected processes and not solely focusing just on the IT parameter.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-141">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-143" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-133" target="5n0gASPAGLLi4WL7JSeG-141">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4660.5" y="4800" as="sourcePoint" />
            <mxPoint x="4720.5" y="4800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-144" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-141" target="5n0gASPAGLLi4WL7JSeG-138">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5020.5" y="4800" as="sourcePoint" />
            <mxPoint x="5080.5" y="4800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-145" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-148" target="5n0gASPAGLLi4WL7JSeG-146">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="6857.5" y="4710" as="sourcePoint" />
            <mxPoint x="6917.5" y="4710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-146" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.07&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Provide early production support." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="7267.5" y="4700" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-147" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;For an agreed period of time, provide early support to users and I&amp;amp;T operations to resolve issues and help stabilize the new solution.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want an early support to be provided to users and IT operations, in order to address issues early and stabilize new solutions.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.08&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-146">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-148" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.06&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Promote to production and manage releases." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="6907.5" y="4700" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-149" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Promote the accepted solution to the business and operations. Where appropriate, run the solution as a pilot implementation or in parallel with the old solution for a defined period and compare behavior and results. If significant problems occur, revert to the original environment based on the fallback/back-up plan. Manage releases of solution components.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the release of new changes and the promotion to production to be well managed and organized, in order to reduce the risk and adverse effects on the business.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.07&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-148">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-150" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.08&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Perform a post-implementation review." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="7627.5" y="4700" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-151" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Conduct a post-implementation review to confirm outcome and results, identify lessons learned, and develop an action plan. Evaluate actual performance and outcomes of the new or changed service against expected performance and outcomes anticipated by the user or customer.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want implementation to be reviewed in a post-implementation phase, in order to enable an enterprise to learn.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-150">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-152" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-146" target="5n0gASPAGLLi4WL7JSeG-150">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="7567.5" y="4700" as="sourcePoint" />
            <mxPoint x="7627.5" y="4700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-153" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Perform acceptance tests." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="6547.5" y="4700" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-154" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Test changes independently, in accordance with the defined test plan, prior to migration to the live operational environment.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want IT changes to be tested according to the test plan prior to migration to the operational environment, in order to identify defects as early as possible and be able to address them without causing a quality reduction of operational services.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="5n0gASPAGLLi4WL7JSeG-153">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-155" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5n0gASPAGLLi4WL7JSeG-153" target="5n0gASPAGLLi4WL7JSeG-148">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="6498" y="4710" as="sourcePoint" />
            <mxPoint x="6558" y="4710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-159" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="FFkF1W79zcPs98VZCzmz-3" target="5n0gASPAGLLi4WL7JSeG-153">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="6348" y="4720" as="sourcePoint" />
            <mxPoint x="6558" y="4620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
