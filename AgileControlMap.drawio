          <mxGeometry x="14970" y="2848" width="1360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="QbQjl6XiDQKdOTIaU__l-23" value="&lt;font color=&quot;#ababab&quot; style=&quot;font-size: 100px;&quot;&gt;&lt;b style=&quot;&quot;&gt;CIS CSC v8&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="16370" y="2848" width="1360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="QbQjl6XiDQKdOTIaU__l-14" value="&lt;font color=&quot;#ababab&quot; style=&quot;font-size: 100px;&quot;&gt;&lt;b style=&quot;&quot;&gt;COBIT 2019&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="11880" y="878" width="1650" height="300" as="geometry" />
        </mxCell>
        <mxCell id="QbQjl6XiDQKdOTIaU__l-15" value="&lt;font color=&quot;#ababab&quot; style=&quot;font-size: 100px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ITIL 4&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="13570" y="878" width="1360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="QbQjl6XiDQKdOTIaU__l-16" value="&lt;font color=&quot;#ababab&quot; style=&quot;font-size: 100px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ISO 27001 &amp;amp; ISO 27002&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="14970" y="878" width="1360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="QbQjl6XiDQKdOTIaU__l-17" value="&lt;font color=&quot;#ababab&quot; style=&quot;font-size: 100px;&quot;&gt;&lt;b style=&quot;&quot;&gt;CIS CSC v8&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;rotation=0;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="16370" y="878" width="1360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-108" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;DSS04.07&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage backup arrangements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3581.25" y="4859" width="300" height="60" as="geometry">
            <mxRectangle x="5428.75" y="3740" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-109" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Maintain availability of business-critical information.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Adapt rapidly, continue business operations and maintain availability of resources and information at a level acceptable to the enterprise in the event of a significant disruption (e.g., threats, opportunities, demands).&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to maintain and update their backup arrangements, in order to have business-critical information available when needed.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="QuHqFJcRldl6wBvhqh9c-108" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-21" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI11.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage project quality." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2503.75" y="4769" width="300" height="60" as="geometry">
            <mxRectangle x="3990" y="2000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-22" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Prepare and execute a quality management plan, processes and practices that align with quality management standards (QMS). Describe the approach to project quality and implementation. The plan should be formally reviewed and agreed on by all parties concerned and incorporated into the integrated project plans.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize defined project outcomes and reduce the risk of unexpected delays, costs and value erosion by improving communications to and involvement of business and end users. Ensure the value and quality of project deliverables and maximize their contribution to the defined programs and investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solid quality management plans, processes and practices to be set up according to the enterprise&#39;s standard, in order to meet quality requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI11.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="QuHqFJcRldl6wBvhqh9c-21" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-23" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI11.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Develop and maintain the project plan." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2143.75" y="4769" width="300" height="60" as="geometry">
            <mxRectangle x="3630" y="2000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-24" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Establish and maintain a formal, approved, integrated project plan (covering business and IT resources) to guide project execution and control throughout the life of the project. The scope of projects should be clearly defined and tied to building or enhancing business capability.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize defined project outcomes and reduce the risk of unexpected delays, costs and value erosion by improving communications to and involvement of business and end users. Ensure the value and quality of project deliverables and maximize their contribution to the defined programs and investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a formal, approved and integrated project plan to guide project execution, in order to control the project.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI11.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="QuHqFJcRldl6wBvhqh9c-23" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-31" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI11.08&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage project resources and work packages." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3581.25" y="4769" width="300" height="60" as="geometry">
            <mxRectangle x="5428.75" y="3650" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-32" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Manage project work packages by placing formal requirements on authorizing and accepting work packages and assigning and coordinating appropriate business and IT resources.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize defined project outcomes and reduce the risk of unexpected delays, costs and value erosion by improving communications to and involvement of business and end users. Ensure the value and quality of project deliverables and maximize their contribution to the defined programs and investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to work packages and project resources to be diligently managed and formally authorized, in order to have a controlled project work.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI11.09&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="QuHqFJcRldl6wBvhqh9c-31" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-33" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI11.07&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Monitor and control projects." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3221.25" y="4769" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="2000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-34" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Measure project performance against key project performance criteria such as schedule, quality, cost and risk. Identify any deviations from expected targets. Assess the impact of deviations on the project and overall program and report results to key stakeholders.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize defined project outcomes and reduce the risk of unexpected delays, costs and value erosion by improving communications to and involvement of business and end users. Ensure the value and quality of project deliverables and maximize their contribution to the defined programs and investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to be monitored and controlled in terms of schedule, quality, cost and risk, in order to identify deviations in any of these parameters as early as possible and being able to react on them.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI11.08&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="QuHqFJcRldl6wBvhqh9c-33" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-38" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI11.06&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Manage project risk." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2863.75" y="4769" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="2000" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-39" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Eliminate or minimize specific risk associated with projects through a systematic process of planning, identifying, analyzing, responding to, monitoring and controlling the areas or events with potential to cause unwanted change. Define and record any risk faced by project management.&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Realize defined project outcomes and reduce the risk of unexpected delays, costs and value erosion by improving communications to and involvement of business and end users. Ensure the value and quality of project deliverables and maximize their contribution to the defined programs and investment portfolio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want project risks to be systematically identified, analyzed, mitigated, monitored and controlled, in order not to exceed the enterprise&#39;s risk appetite.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI11.07&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="QuHqFJcRldl6wBvhqh9c-38" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-20" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="QuHqFJcRldl6wBvhqh9c-23" target="QuHqFJcRldl6wBvhqh9c-21" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2093.75" y="4779" as="sourcePoint" />
            <mxPoint x="2153.75" y="4779" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-25" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="QuHqFJcRldl6wBvhqh9c-21" target="QuHqFJcRldl6wBvhqh9c-38" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2443.75" y="4769" as="sourcePoint" />
            <mxPoint x="2503.75" y="4769" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-30" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="QuHqFJcRldl6wBvhqh9c-33" target="QuHqFJcRldl6wBvhqh9c-31" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3171.25" y="4779" as="sourcePoint" />
            <mxPoint x="3231.25" y="4779" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QuHqFJcRldl6wBvhqh9c-43" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="QuHqFJcRldl6wBvhqh9c-38" target="QuHqFJcRldl6wBvhqh9c-33" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2813.75" y="4779" as="sourcePoint" />
            <mxPoint x="2873.75" y="4779" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-136" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI07.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Establish a test environment." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3582.5" y="4679" width="300" height="60" as="geometry">
            <mxRectangle x="3990" y="4790" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-137" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Define and establish a secure test environment representative of the planned business process and IT operations environment in terms of performance, capacity, security, internal controls, operational practices, data quality, privacy requirements and workloads.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Implement solutions safely and in line with the agreed expectations and outcomes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to have for each agile solution development project a representative testing environment set up that reflects the future production conditions, in order to perform tests that are representative for the future operational processes.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI07.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-136" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-107" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI05.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Enable operation and use." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3582.5" y="4589" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-108" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Plan and implement all technical, operational and usage aspects so all those who are involved in the future state environment can exercise their responsibility.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Prepare and commit stakeholders for business change and reduce the risk of failure.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want operations to be already planned in the development phase, in order to assure a solid operation from day 1.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI05.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-107" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-89" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Monitor and review availability and capacity." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3222.5" y="4499" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="3380" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-90" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Monitor, measure, analyze, report and review availability, performance and capacity. Identify deviations from established baselines. Review trend analysis reports identifying any significant issues and variances. Initiate actions where necessary and ensure that all outstanding issues are addressed.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want new solutions to be onboarded to the monitoring process as early as possible, in order to identify deviations from established baselines and enable the availability, capacity and performance management process to initiate actions.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI04.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-89" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-91" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Plan for new or changed service requirements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2862.5" y="4499" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4140" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-92" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Plan and prioritize availability, performance and capacity implications of changing business needs and service requirements.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want changing business needs and service requirements related to availability, performance an capacity to be considered in agile solution development projects, in order to address or at least consider them in course of development.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI04.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-91" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-93" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;Investigate and address availability, performance and&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;capacity issues.&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3582.5" y="4499" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4140" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-94" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Address deviations by investigating and resolving identified availability, performance and capacity issues.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to be aware that issues regarding availability, performance or capacity management in relation to their solution might have to be addressed by them in course of the project work, in order to assure the required level of availability, performance and capacity.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-93" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-96" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI04.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Assess business impact." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2502.5" y="4499" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="4140" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-97" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Identify important services to the enterprise. Map services and resources to business processes and identify business dependencies. Ensure that the impact of unavailable resources is fully agreed on and accepted by the customer. For vital business functions, ensure that availability requirements can be satisfied per service level agreement (SLA).&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Maintain service availability, efficient management of resources and optimization of system performance through prediction of future performance and capacity requirements.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want newly implemented services and resources to be mapped to business processes, in order to configure new solutions according to the business needs.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI04.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-96" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-88" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="5n0gASPAGLLi4WL7JSeG-91" target="5n0gASPAGLLi4WL7JSeG-89" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2812.5" y="4509" as="sourcePoint" />
            <mxPoint x="2872.5" y="4509" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-95" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="5n0gASPAGLLi4WL7JSeG-89" target="5n0gASPAGLLi4WL7JSeG-93" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3522.5" y="4499" as="sourcePoint" />
            <mxPoint x="3582.5" y="4499" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-98" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="5n0gASPAGLLi4WL7JSeG-96" target="5n0gASPAGLLi4WL7JSeG-91" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2453" y="4509" as="sourcePoint" />
            <mxPoint x="2513" y="4509" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-53" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.02&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Design detailed solution components." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="340" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="1827.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-54" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop, document and elaborate detailed designs progressively. Use agreed and appropriate phased or rapid Agile development techniques, addressing all components (business processes and related automated and manual controls, supporting I&amp;amp;T applications, infrastructure services and technology products, and partners/suppliers). Ensure that the detailed design includes internal and external service level agreements (SLAs) and operational level agreements (OLAs).&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solution components to be developed, documented and elaborated in a detailed manner, in order to to develop a diligently planned solution.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-53" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-57" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.03&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Develop solution components." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="700" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="2187.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-58" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Develop solution components progressively in a separate environment, in accordance with detailed designs following standards and requirements for development and documentation, quality assurance (QA), and approval. Ensure that all control requirements in the business processes, supporting I&amp;amp;T applications and infrastructure services, services and technology products, and partner/vendor services are addressed.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solution components to be orderly developed, in order an appropriate quality in alignment with the business requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-57" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-59" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.04&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Procure solution components." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="1060" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="2547.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-60" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Procure solution components, based on the acquisition plan, in accordance with requirements and detailed designs, architecture principles and standards, and the enterprise’s overall procurement and contract procedures, QA requirements, and approval standards. Ensure that all legal and contractual requirements are identified and addressed by the vendor.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the procurement of solution components to be diligently performed in accordance with requirements, in order to ensure that standards are met, quality is achieved and contractual requirements are met.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-59" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-64" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.07&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Prepare for solution testing." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2140" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="3627.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-65" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Establish a test plan and required environments to test the individual and integrated solution components. Include the business processes and supporting services, applications and infrastructure.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want testing of solutions to be diligently prepared, in order to assure effective testing.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.08&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-64" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-66" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.06&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Perform quality assurance (QA)." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="1780" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="3270" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-67" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop, resource and execute a QA plan aligned with the QMS to obtain the quality specified in the requirements definition and in the enterprise’s quality policies and procedures.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a solid QA plan to be executed, in order to meet the enterprise&#39;s quality standards.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.07&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-66" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-71" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.05&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Build solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="1420" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="2907.5" y="2540" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-72" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Install and configure solutions and integrate with business process activities. During configuration and integration of hardware and infrastructure software, implement control, security, privacy and auditability measures to protect resources and ensure availability and data integrity. Update the product or services catalogue to reflect the new solutions.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a well configured solution integrated with business process, in order to met - among others - confidentiality, privacy, integrity and availability requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-71" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-76" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.11&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Define IT products and services and maintain the service portfolio." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3220" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-77" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Define and agree on new or changed IT products or services and service level options. Document new or changed product and service definitions and service level options to be updated in the products and services portfolio.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to have a clear oversight of current IT services and IT products, in order to keep an overview of the current IT landscape.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.12&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-76" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-78" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.10&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Maintain solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2860" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-79" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop and execute a plan for the maintenance of solution and infrastructure components. Include periodic reviews against business needs and operational requirements.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want developed solutions to be adequately maintained on a continuous basis, in order to assure a sustainable quality.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.11&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-78" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-80" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.12&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Design solutions based on the defined development methodology." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3580" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-81" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Design, develop and implement solutions with the appropriate development methodology (i.e., waterfall, Agile or bimodal I&amp;amp;T), in accordance with the overall strategy and requirements.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want solutions to be developed with an appropriate development methodology in line with the overall strategy and requirements, in order to assure an unified procedure and appropriate quality.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-80" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-83" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;BAI03.09&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Manage changes to requirements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="2500" y="4409" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="4070" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5n0gASPAGLLi4WL7JSeG-84" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Track the status of individual requirements (including all rejected requirements) throughout the project life cycle. Manage the approval of changes to requirements.&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure agile and scalable delivery of digital products and services. Establish timely and cost-effective solutions (technology, business processes and workflows) capable of supporting enterprise strategic and operational objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want changes to requirements and their approval to be sufficiently tracked, in order to maintain sufficient oversight of requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: BAI03.10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="5n0gASPAGLLi4WL7JSeG-83" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
