          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-31" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" parent="1" source="izNcHli7krDH618Io2Hl-26" target="izNcHli7krDH618Io2Hl-29" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5370" y="3070" as="sourcePoint" />
            <mxPoint x="5397.5" y="1810" as="targetPoint" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-33" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" parent="1" source="izNcHli7krDH618Io2Hl-35" target="izNcHli7krDH618Io2Hl-37" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5900" y="2120" as="sourcePoint" />
            <mxPoint x="5950" y="2070" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-41" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="izNcHli7krDH618Io2Hl-37" target="VOTrehMlLt_2pqgxl_0n-1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5300" y="2490" as="sourcePoint" />
            <mxPoint x="5350" y="2440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-42" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="izNcHli7krDH618Io2Hl-39" target="FFkF1W79zcPs98VZCzmz-2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5612.5" y="3680" as="sourcePoint" />
            <mxPoint x="5662.5" y="3630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-29" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM03.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Monitor risk management." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5427.5" y="1760" width="300" height="60" as="geometry">
            <mxRectangle x="6560" y="2490" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-30" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Monitor the key goals and metrics of the risk management processes. Determine how deviations or problems will be identified, tracked and reported for remediation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Secure optimal value from I&amp;amp;T-enabled initiatives, services and assets; cost-efficient delivery of solutions and services; and a reliable and accurate picture of costs and likely benefits so that business needs are supported effectively and efficiently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want metrics of risks (e.g. KRIs) to be established by agile projects, so that deviations or problems can be detected and remediated.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-29" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-39" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM04.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Monitor resource management." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="2930" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3670" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-40" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Monitor the key goals and metrics of the resource management processes. Determine how deviations or problems will be identified, tracked and reported for remediation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that the resource needs of the enterprise are met in the optimal manner, I&amp;amp;T costs are optimized, and there is an increased likelihood of benefit realization and readiness for future change.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want to make sure that a monitoring of resources is established, so that deviations can be identified and remediated.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-39" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-37" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM04.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Direct resource management." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="1860" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3050" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-38" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Ensure the adoption of resource management principles to enable optimal use of business and I&amp;amp;T resources throughout their full economic life cycle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that the resource needs of the enterprise are met in the optimal manner, I&amp;amp;T costs are optimized, and there is an increased likelihood of benefit realization and readiness for future change.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want to make sure resource management principles are ensured; so that responsibilities, alignment processes and metrics are established.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM04.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-37" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-35" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM04.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Evaluate resource management." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="1860" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="3050" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-36" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Continually examine and evaluate the current and future need for business and I&amp;amp;T resources (financial and human), options for resourcing (including sourcing strategies), and allocation and management principles to meet the needs of the enterprise in the optimal manner.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that the resource needs of the enterprise are met in the optimal manner, I&amp;amp;T costs are optimized, and there is an increased likelihood of benefit realization and readiness for future change.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want to make sure that all resource requirements of agile initiatives are continually examined and evaluated, so that lacking resources (financial and human) are prevented.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM04.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-35" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-24" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM03.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Evaluate risk management." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4710" y="1760" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="3190" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-25" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Continually examine and evaluate the effect of risk on the current and future use of I&amp;amp;T in the enterprise. Consider whether the enterprise’s risk appetite is appropriate and ensure that risk to enterprise value related to the use of I&amp;amp;T is identified and managed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Secure optimal value from I&amp;amp;T-enabled initiatives, services and assets; cost-efficient delivery of solutions and services; and a reliable and accurate picture of costs and likely benefits so that business needs are supported effectively and efficiently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want risks within agile projects to be evaluated, so that the enterprise&#39;s risk appetite is not exceeded.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM03.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-24" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-26" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM03.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Direct risk management." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="1760" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3190" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-27" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Direct the establishment of risk management practices to provide reasonable assurance that I&amp;amp;T risk management practices are appropriate and that actual I&amp;amp;T risk does not exceed the board’s risk appetite.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Secure optimal value from I&amp;amp;T-enabled initiatives, services and assets; cost-efficient delivery of solutions and services; and a reliable and accurate picture of costs and likely benefits so that business needs are supported effectively and efficiently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want risk management practices to be applied, so that the enterprise&#39;s risk appetite is not exceeded.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM03.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-26" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-20" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM02.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Monitor value optimization." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="1670" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3090" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-21" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Monitor key goals and metrics to determine whether the enterprise receives expected value and benefit from I&amp;amp;T-enabled investments and services. Identify significant issues and consider corrective actions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Secure optimal value from I&amp;amp;T-enabled initiatives, services and assets; cost-efficient delivery of solutions and services; and a reliable and accurate picture of costs and likely benefits so that business needs are supported effectively and efficiently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want financial investments to be monitored and corrective measures are initiated, so that value is realized in an optimal manner in course of the whole epic.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-20" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-17" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM02.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Direct value optimization." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="1670" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="3090" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-18" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Direct value management principles and practices to enable optimal value realization from I&amp;amp;T-enabled investments throughout their full economic life cycle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Secure optimal value from I&amp;amp;T-enabled initiatives, services and assets; cost-efficient delivery of solutions and services; and a reliable and accurate picture of costs and likely benefits so that business needs are supported effectively and efficiently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want financial investments to be managed in a diligent manner, so that value is realized in the enterprises interest.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM02.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-17" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-14" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM02.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Evaluate value optimization." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4710" y="1670" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="3090" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-15" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Continually evaluate the portfolio of I&amp;amp;T-enabled investments, services and assets to determine the likelihood of achieving enterprise objectives and delivering value. Identify and evaluate any changes in direction to management that will optimize value creation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Secure optimal value from I&amp;amp;T-enabled initiatives, services and assets; cost-efficient delivery of solutions and services; and a reliable and accurate picture of costs and likely benefits so that business needs are supported effectively and efficiently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want investments to be evaluated on their suitability, so that enterprise objectives are met and value is delivered in the most optimized manner.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM02.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-14" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-12" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM02.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Establish the target investment mix." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4350" y="1670" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="3090" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-13" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Review and ensure clarity of the enterprise and I&amp;amp;T strategies and current services. Define an appropriate investment mix based on cost, alignment with strategy, type of benefit for the programs in the portfolio, degree of risk, and financial measures such as cost and expected return on investment (ROI) over the full economic life cycle. Adjust the enterprise and I&amp;amp;T strategies where necessary.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Secure optimal value from I&amp;amp;T-enabled initiatives, services and assets; cost-efficient delivery of solutions and services; and a reliable and accurate picture of costs and likely benefits so that business needs are supported effectively and efficiently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want investments within agile projects to be aligned with the enterprises strategy, so that new financial resources are facilitated in an optimized manner.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM02.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-12" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="nE-EjzNcMq43JnrIoQBQ-26" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM01.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Evaluate the governance system." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4710" y="1560" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="2750" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nE-EjzNcMq43JnrIoQBQ-37" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Continually identify and engage with the enterprise’s stakeholders, document an understanding of the requirements, and evaluate the current and future design of governance of enterprise I&amp;amp;T.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Provide a consistent approach integrated and aligned with the enterprise governance approach. I&amp;amp;T-related decisions are made in line with the enterprise’s strategies and objectives and desired value is realized. To that end, ensure that I&amp;amp;T-related processes are overseen effectively and transparently; compliance with legal, contractual and regulatory requirements is confirmed; and the governance requirements for board members are met.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want to make sure that agile initiatives are in compliance with the governance system as well as in alignment with the enterprise&#39;s strategy, so that new developments align with the companies goals and governance principles.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;&quot;&gt;Direct Successor&lt;/u&gt;: EDM01.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="nE-EjzNcMq43JnrIoQBQ-26" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-3" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM01.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Direct the governance system." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="1560" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="2980" width="360" height="400" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-4" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Inform leaders on I&amp;amp;T governance principles and obtain their support, buy-in and commitment. Guide the structures, processes and practices for the governance of I&amp;amp;T in line with the agreed governance principles, decision-making models and authority levels. Define the information required for informed decision making.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Provide a consistent approach integrated and aligned with the enterprise governance approach. I&amp;amp;T-related decisions are made in line with the enterprise’s strategies and objectives and desired value is realized. To that end, ensure that I&amp;amp;T-related processes are overseen effectively and transparently; compliance with legal, contractual and regulatory requirements is confirmed; and the governance requirements for board members are met.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want leaders to support the governance principles, so that a compliance to these principles is ensured by increased awareness.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM01.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-3" vertex="1">
          <mxGeometry y="60" width="360" height="340" as="geometry" />
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-6" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM01.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Monitor the governance system." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="1560" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="2980" width="360" height="400" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="izNcHli7krDH618Io2Hl-7" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;Monitor the effectiveness and performance of the enterprise’s governance of I&amp;amp;T. Assess whether the governance system and implemented mechanisms (including structures, principles and processes) are operating effectively and provide appropriate oversight of I&amp;amp;T to enable value creation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Provide a consistent approach integrated and aligned with the enterprise governance approach. I&amp;amp;T-related decisions are made in line with the enterprise’s strategies and objectives and desired value is realized. To that end, ensure that I&amp;amp;T-related processes are overseen effectively and transparently; compliance with legal, contractual and regulatory requirements is confirmed; and the governance requirements for board members are met.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As an enterprise&#39;s stakeholder, I want the governance system and mechanisms to be assessed within agile projects, so that a compliance to these principles is ensured and operational effectiveness is given.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="izNcHli7krDH618Io2Hl-6" vertex="1">
          <mxGeometry y="60" width="360" height="340" as="geometry" />
        </mxCell>
        <mxCell id="N0caBlmLojgxpRJd6Mx--2" value="Key Functions Def." style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="6050" y="1660" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-4" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO.08&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Define target skills and competencies." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="3170" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3910" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-5" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Define the required skills and competencies to achieve relevant&lt;/div&gt;&lt;div&gt;management objectives.&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Implement a consistent management approach for enterprise governance requirements to be met, covering governance components such as&amp;nbsp;management processes; organizational structures; roles and responsibilities; reliable and repeatable activities; information items; policies and&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;procedures; skills and competencies; culture and behavior; and services, infrastructure and applications.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board member of the company, I want to have an overview of target skills and competencies, so that I can plan and forecast my human resources.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-4" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-6" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-4" target="FFkF1W79zcPs98VZCzmz-2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5732.5" y="3660" as="sourcePoint" />
            <mxPoint x="6024.5" y="3560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-7" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-16" target="sbHoc3gWJixWeE4EDV6L-14" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="3910" y="2230" as="sourcePoint" />
            <mxPoint x="3960" y="2180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-8" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-14" target="sbHoc3gWJixWeE4EDV6L-12" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4290" y="2040" as="sourcePoint" />
            <mxPoint x="4290" y="1990" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-9" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-12" target="sbHoc3gWJixWeE4EDV6L-10" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4300" y="2050" as="sourcePoint" />
            <mxPoint x="4360" y="2050" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-10" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO02.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Conduct a gap analysis." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4710" y="2040" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="3230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-11" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Identify gaps between current and target environments and describe the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;high-level changes in the enterprise architecture.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Support the digital transformation strategy of the organization and deliver the desired value through a road map of incremental changes. Use a&amp;nbsp;holistic I&amp;amp;T approach, ensuring that each initiative is clearly connected to an overarching strategy. Enable change in all different aspects of the&amp;nbsp;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;organization, from channels and processes to data, culture, skills, operating model and incentives.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As a stakeholder of the company, I want the agile project team to identify gaps between the current and the target environment products and services, in order to describe the high-level change in their epics.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO02.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-10" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-12" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO02.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Define target digital capabilities." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4350" y="2040" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="3230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-13" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Based on the understanding of enterprise context and direction, define&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;the target I&amp;amp;T products and services and required capabilities. Consider&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;reference standards, best practices and validated emerging technologies.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Support the digital transformation strategy of the organization and deliver the desired value through a road map of incremental changes. Use a&amp;nbsp;holistic I&amp;amp;T approach, ensuring that each initiative is clearly connected to an overarching strategy. Enable change in all different aspects of the&amp;nbsp;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;organization, from channels and processes to data, culture, skills, operating model and incentives.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As a stakeholder of the company, I want the agile project team to define target products and services, in order to define epics meeting those set targets.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO02.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-12" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-14" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO02.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;Assess current capabilities, performance and digital&lt;div&gt;maturity of the enterprise.&lt;/div&gt;" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3990" y="2040" width="300" height="60" as="geometry">
            <mxRectangle x="3990" y="3230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-15" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Assess the performance of current I&amp;amp;T services and develop an&lt;/div&gt;&lt;div&gt;understanding of current business and I&amp;amp;T capabilities (both internal&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;and external). Assess current digital maturity of the enterprise and its&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;appetite for change.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Support the digital transformation strategy of the organization and deliver the desired value through a road map of incremental changes. Use a&amp;nbsp;holistic I&amp;amp;T approach, ensuring that each initiative is clearly connected to an overarching strategy. Enable change in all different aspects of the&amp;nbsp;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;organization, from channels and processes to data, culture, skills, operating model and incentives.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As a stakeholder of the company, I want the agile project team to gain an understanding of the current services an capabilities, so that they can develop epics based on the current digital maturity and its appetite for change.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO02.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-14" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-16" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO02.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Design the management system for enterprise I&amp;amp;T." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="3630" y="2040" width="300" height="60" as="geometry">
            <mxRectangle x="3630" y="3230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-17" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Understand the enterprise context (industry drivers, relevant regulations,&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;basis for competition), its current way of working and its ambition level&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;in terms of digitization.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Support the digital transformation strategy of the organization and deliver the desired value through a road map of incremental changes. Use a&amp;nbsp;holistic I&amp;amp;T approach, ensuring that each initiative is clearly connected to an overarching strategy. Enable change in all different aspects of the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;organization, from channels and processes to data, culture, skills, operating model and incentives.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As a stakeholder of the company, I want the agile project team to understand the enterprises context, so that they can develop epics that meet all contextual requirements.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO02.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-16" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-18" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO02.05&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Define the strategic plan and road map." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="2040" width="300" height="60" as="geometry">
            <mxRectangle x="5062.5" y="2700" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-19" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Develop a holistic digital strategy, in cooperation with relevant&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;stakeholders, and detail a road map that defines the incremental steps&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;required to achieve the goals and objectives. Ensure focus on the&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;transformation journey through the appointment of a person who helps&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;spearhead the digital transformation and drives alignment between&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;business and I&amp;amp;T.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;Support the digital transformation strategy of the organization and deliver the desired value through a road map of incremental changes. Use a&amp;nbsp;holistic I&amp;amp;T approach, ensuring that each initiative is clearly connected to an overarching strategy. Enable change in all different aspects of the&amp;nbsp;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;organization, from channels and processes to data, culture, skills, operating model and incentives.&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As a stakeholder of the company, I want the agile project team to define a incremental road map with incremental steps in the format of epics as well as appointing persons, in order to implement the target environment.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO02.06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-18" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-20" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO02.06&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Monitor value optimization." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="2040" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3230" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-21" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Create awareness and understanding of the business and I&amp;amp;T objectives&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;and direction, as captured in the I&amp;amp;T strategy, through communication to&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;appropriate stakeholders and users throughout the enterprise.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Support the digital transformation strategy of the organization and deliver the desired value through a road map of incremental changes. Use a&amp;nbsp;holistic I&amp;amp;T approach, ensuring that each initiative is clearly connected to an overarching strategy. Enable change in all different aspects of the&amp;nbsp;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;organization, from channels and processes to data, culture, skills, operating model and incentives.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As a stakeholder of the company, I want a project team that is informed about the strategy, in order create awareness and understanding.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-20" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-22" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-10" target="sbHoc3gWJixWeE4EDV6L-18" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5010" y="2040" as="sourcePoint" />
            <mxPoint x="5070" y="2040" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-23" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-18" target="sbHoc3gWJixWeE4EDV6L-20" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5020" y="2050" as="sourcePoint" />
            <mxPoint x="5080" y="2050" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-24" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-20" target="VOTrehMlLt_2pqgxl_0n-1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5820" y="2030" as="sourcePoint" />
            <mxPoint x="5880" y="2030" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-25" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-34" target="VOTrehMlLt_2pqgxl_0n-1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4270" y="2320" as="sourcePoint" />
            <mxPoint x="5470" y="2250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-26" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-32" target="sbHoc3gWJixWeE4EDV6L-30" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4650" y="2580" as="sourcePoint" />
            <mxPoint x="4650" y="2530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-27" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-30" target="sbHoc3gWJixWeE4EDV6L-28" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4660" y="2590" as="sourcePoint" />
            <mxPoint x="4720" y="2590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-28" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Define architecture implementation." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="3250" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-29" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Create a viable implementation and migration plan in alignment with the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;program and project portfolios. Ensure the plan is closely coordinated to&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;deliver value and that the required resources are available to complete&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;the necessary work.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board , I want the agile project team to create a viable implementation and a mitigation plan, in order to put the new architectural design in place.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-28" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-30" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Select opportunities and solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="3250" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-31" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Rationalize the gaps between baseline and target architectures,&lt;/div&gt;&lt;div&gt;accounting for both business and technical perspectives, and logically&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;group them into project work packages. Integrate the project with any&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;related I&amp;amp;T-enabled investment programs to ensure that the architectural&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;initiatives are aligned with and enable these initiatives as part of&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;overall enterprise change. Make this a collaborative effort with key&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;enterprise stakeholders from business and IT to assess the enterprise’s&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;transformation readiness, and identify opportunities, solutions and all&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;implementation constraints.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want the agile project team to evaluate the gap between the current baseline and the target architecture, in order to work on closing the gap during their sprints.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-30" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-32" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Define reference architecture." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4710" y="3250" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-33" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;The reference architecture describes the current and target architectures&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;for the business, information, data, application and technology domains.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want the agile project team to describe the target architecture for the business and review the current architecture, so that IT solutions can be build according to the target architecture and the effects of the new developments to the current architecture is evaluated.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-32" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-34" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Develop the enterprise architecture vision." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="2130" width="300" height="60" as="geometry">
            <mxRectangle x="3990" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-35" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;The architecture vision provides a first-cut, high-level description of the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;baseline and target architectures, covering the business, information,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;data, application and technology domains. The architecture vision&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;provides the sponsor with a key tool to sell the benefits of the proposed&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;capabilities to stakeholders within the enterprise. The architecture&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;vision describes how the new capabilities (in line with I&amp;amp;T strategy&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;and objectives) will meet enterprise goals and strategic objectives and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;address stakeholder concerns when implemented.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want the agile project team to develop for their epics an architectural vision, high-level baseline and target architecture, so that the architectural design follows a clear vision.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-34" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-38" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-28" target="FFkF1W79zcPs98VZCzmz-2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5362.5" y="3140" as="sourcePoint" />
            <mxPoint x="5422.5" y="3140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-39" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-42" target="sbHoc3gWJixWeE4EDV6L-40" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4300" y="2230" as="sourcePoint" />
            <mxPoint x="4360" y="2230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-40" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Create and maintain budgets." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4710" y="2220" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="3410" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-41" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Prepare a budget reflecting investment priorities based on the portfolio&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;of I&amp;amp;T-enabled programs and I&amp;amp;T services.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a budget which reflects the investment priorities, in order to strategically allocate resources effectively.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO06.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-40" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-42" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Prioritize resource allocation." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4350" y="2220" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="3410" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-43" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Implement a decision-making process to prioritize the allocation of&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;resources and establish rules for discretionary investments by individual&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;business units. Include the potential use of external service providers&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;and consider the buy, develop and rent options.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to implement clear decision-making processes to allocate resources, in order to establish a transparent and traceable process.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO06.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-42" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-44" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Model and allocate costs." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="2220" width="300" height="60" as="geometry">
            <mxRectangle x="5062.5" y="2880" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-45" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Establish and use an I&amp;amp;T costing model based, for example, on the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;service definition. This approach ensures that allocation of costs for&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;services is identifiable, measurable and predictable, and encourages&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;the responsible use of resources, including those provided by service&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;providers. Regularly review and benchmark the cost/chargeback model&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;to maintain its relevance and appropriateness for evolving business and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;IT activities.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want costs to be clearly assigned, in order to make costs identifiable, measureable and rpedictable.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO06.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-44" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-46" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.05&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage costs." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="2220" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3410" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-47" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Implement a cost management process that compares actual costs&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;against budget. Costs should be monitored and reported. Deviations&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;from budget should be identified in a timely manner and their impact on&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;enterprise processes and services assessed.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to be well informed on the budget consumption and any deviations, in order to be able to react on deviations.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-46" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-48" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-40" target="sbHoc3gWJixWeE4EDV6L-44" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5010" y="2220" as="sourcePoint" />
            <mxPoint x="5070" y="2220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-49" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-44" target="sbHoc3gWJixWeE4EDV6L-46" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5020" y="2230" as="sourcePoint" />
            <mxPoint x="5080" y="2230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-50" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-46" target="VOTrehMlLt_2pqgxl_0n-1" edge="1">
