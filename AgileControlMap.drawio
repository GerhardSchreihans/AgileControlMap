n.%26lt%3Bbr%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20background-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BEnabler%20Story%3A%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BAs%20management%20of%20the%20enterprise%2C%20want%20agile%20solution%20development%20projects%20to%20contribute%20to%20a%20well%20established%20knowledge%20management%20environment%2C%20in%20order%20to%20maintain%20solution%2Fproduct%2Fproject%20knowledge%20in%20a%20manner%20that%20fits%20to%20the%20enterprise.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3B%26lt%3Bu%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%26quot%3B%26gt%3BDirect%20Successor%26lt%3B%2Fu%26gt%3B%3A%20Knowledge%20management%20(3.2.2)%26lt%3B%2Ffont%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3B%22%20vertex%3D%221%22%20parent%3D%222%22%3E%3CmxGeometry%20y%3D%2260%22%20width%3D%22360%22%20height%3D%22350%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%224%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%26amp%3Bnbsp%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20font-weight%3A%20400%3B%26quot%3B%26gt%3BKnowledge%20management%20(3.2.2)%26lt%3B%2Fi%26gt%3B%26lt%3Bbr%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20On-demand%20information%20discovery%22%20style%3D%22swimlane%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BstartSize%3D60%3BfillColor%3D%23E1D5E7%3BstrokeColor%3D%23A680B8%3B%22%20vertex%3D%221%22%20collapsed%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%225433%22%20y%3D%221990%22%20width%3D%22300%22%20height%3D%2260%22%20as%3D%22geometry%22%3E%3CmxRectangle%20x%3D%225073%22%20y%3D%221720%22%20width%3D%22360%22%20height%3D%22410%22%20as%3D%22alternateBounds%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%225%22%20value%3D%22%26lt%3Bb%26gt%3BControl%20Description%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Registration%20of%20information%20request%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Research%20and%20data%20collection%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Information%20processing%20and%20presentation%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Information%20acceptance%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Knowledge%20integration%20and%20review%26lt%3B%2Fdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BControl%20Objective%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3BThe%20purpose%20of%20the%20knowledge%20management%20practice%20is%20to%20maintain%20and%20improve%20the%20effective%2C%20efficient%2C%20and%20convenient%20use%20of%20information%20and%20knowledge%20across%20the%20organization.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BEnabler%20Story%3A%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BAs%20management%20of%20the%20enterprise%2C%20I%20want%20agile%20solution%20development%20projects%20to%20follow%20and%20apply%20on-demand%20information%20discovery%20processes%20to%20be%20established%2C%20in%20order%20to%20explore%20and%20research%20new%20information%20in%20an%20adequate%20quality.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3B%26lt%3Bu%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%26quot%3B%26gt%3BDirect%20Successor%26lt%3B%2Fu%26gt%3B%3A%26amp%3Bnbsp%3B%26lt%3B%2Ffont%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3BKnowledge%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3Bmanagement%20(3.2.3)%26lt%3B%2Fspan%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3B%22%20vertex%3D%221%22%20parent%3D%224%22%3E%3CmxGeometry%20y%3D%2260%22%20width%3D%22360%22%20height%3D%22350%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%226%22%20value%3D%22%22%20style%3D%22endArrow%3Dclassic%3Bhtml%3D1%3Brounded%3D0%3BentryX%3D0%3BentryY%3D0%3BentryDx%3D0%3BentryDy%3D0%3BexitX%3D1%3BexitY%3D0%3BexitDx%3D0%3BexitDy%3D0%3B%22%20edge%3D%221%22%20source%3D%222%22%20target%3D%224%22%20parent%3D%221%22%3E%3CmxGeometry%20width%3D%2250%22%20height%3D%2250%22%20relative%3D%221%22%20as%3D%22geometry%22%3E%3CmxPoint%20x%3D%225023%22%20y%3D%222000%22%20as%3D%22sourcePoint%22%2F%3E%3CmxPoint%20x%3D%225083%22%20y%3D%222000%22%20as%3D%22targetPoint%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;management (3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Managing a common approach to relationships" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4980.5" y="1728" width="300" height="60" as="geometry">
            <mxRectangle x="5073" y="2080" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="NjYFKYjcXnlCeQA4j0BC-2" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Analyse the organization&#39;s culture, strategy, and stakeholders&lt;/div&gt;&lt;div&gt;- Develop and agree key principles of relationships&lt;/div&gt;&lt;div&gt;- Develop and agree relationship models for key stakeholder groups&lt;/div&gt;&lt;div&gt;- Embed effective behaviour patterns into daily work interactions&lt;/div&gt;&lt;div&gt;- Review and adjust the relationship&#39;s approach and model&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the relationship management practice is to establish and nurture the links between the organization and its stakeholders at strategic and tactical levels. It includes the identification, analysis, monitoring, and continual improvement of relationships with and between stakeholders.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, want agile solution development projects to follow relationship principles and adjust them according to their purposes, in order to address stakeholder expectations.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Relationship management (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="NjYFKYjcXnlCeQA4j0BC-1" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="oTJ3HsHo-e2HUiJ0V5Zs-9" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ISO 27001 &amp;amp; 27002 - 5.33&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Protection of records" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5392.5" y="1730" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3340" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oTJ3HsHo-e2HUiJ0V5Zs-10" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Records should be protected from loss, destruction, falsification, unauthorized access and unauthorized release.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;To ensure compliance with legal, statutory, regulatory and contractual requirements, as well as community or societal expectations related to the protection and availability of records.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to assure that protection and retention requirements of records are met, in order to ensure compliance with those requirements and keep records available as needed.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="oTJ3HsHo-e2HUiJ0V5Zs-9" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="3NLvPx2ckS6_KmLze-8x-19" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ISO 27001 &amp;amp; 27002 - 8.30&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Outsourced development" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5750" y="1729" width="300" height="60" as="geometry">
            <mxRectangle x="5427.5" y="4600" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3NLvPx2ckS6_KmLze-8x-20" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;The organization should direct, monitor and review the activities related to outsourced system&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;development.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;To ensure information security measures required by the organization are implemented in outsourced&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;system development.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to direct, monitor and review the activities related to outsourced system development, in order to ensure information security measures required by the organization are implemented in outsourced system development.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="3NLvPx2ckS6_KmLze-8x-19" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ibRm7NSeTpzZEgZbGgji-7" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;CIS CSC - 14.6&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;Train Workforce Members on Recognizing and Reporting Security Incidents" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="6800" y="1729" width="300" height="60" as="geometry">
            <mxRectangle x="6800" y="1729" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ibRm7NSeTpzZEgZbGgji-8" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Train workforce members to be able to recognize a potential incident and be able to report such an incident.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;The actions of people play a critical part in the success or failure of an enterprise’s security program. It is easier for an attacker to entice a user to click a link or open an email attachment to install malware in order to get into an enterprise, than to find a network exploit to do it directly.&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the organization, I want agile solution development projects to train project team members on recognizing and reporting security incidents, in order to increase knowledge and awareness on this vital security topic.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="ibRm7NSeTpzZEgZbGgji-7" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="j14fxGzRAlY_bbs1dScx-22" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;CIS CSC - 17.1&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Designate Personnel to Manage Incident Handling" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="7160" y="1728" width="300" height="60" as="geometry">
            <mxRectangle x="7160" y="1728" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="j14fxGzRAlY_bbs1dScx-23" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Designate one key person, and at least one backup, who will manage the enterprise’s incident handling process. Management personnel are responsible for the coordination and documentation of incident response and recovery efforts and can consist of employees internal to the enterprise, service providers, or a hybrid approach. If using a service provider, designate at least one person internal to the enterprise to oversee any third-party work. Review annually, or when significant enterprise changes occur that could impact this Safeguard.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;The primary goal of incident response is to identify threats on the enterprise, respond to them before they can spread, and remediate them before they can cause harm.&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the organization, I want agile solution development projects to assure that designated personnel is available for managing incidents and to contact them to preliminarily inform them on the project scope, in order to avoid mishandling of incidents in production.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="j14fxGzRAlY_bbs1dScx-22" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="nB1jEptSUxtJqMZ95UXG-48" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Project&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-style: normal; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20font-weight%3A%20400%3B%26quot%3B%26gt%3BKnowledge%20management%20(3.2.1)%26lt%3B%2Fi%26gt%3B%26lt%3Bbr%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%20Establishing%20and%20maintaining%20the%20knowledge%20management%20environment%22%20style%3D%22swimlane%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BstartSize%3D60%3BfillColor%3D%23E1D5E7%3BstrokeColor%3D%23A680B8%3B%22%20vertex%3D%221%22%20collapsed%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%225073%22%20y%3D%221990%22%20width%3D%22300%22%20height%3D%2260%22%20as%3D%22geometry%22%3E%3CmxRectangle%20x%3D%224713%22%20y%3D%221720%22%20width%3D%22360%22%20height%3D%22410%22%20as%3D%22alternateBounds%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%223%22%20value%3D%22%26lt%3Bb%26gt%3BControl%20Description%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Understand%20current%20culture%20of%20knowledge%20usage%20and%20knowledge%20sharing%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Review%20external%20and%20internal%20requirements%20and%20factors%20of%20influence%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-