<mxfile host="app.diagrams.net" modified="2024-02-18T14:28:58.511Z" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" etag="nlouhuqFVSoNr2qu1btC" version="23.1.1" type="github">
  <diagram name="Page-1" id="850UgzXcZYhpinT9VpMZ">
    <mxGraphModel dx="1975" dy="1002" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="20000" pageHeight="20000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sbHoc3gWJixWeE4EDV6L-1" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO.07&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Define information (data) and system ownership." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="3090" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3830" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-2" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Define and maintain responsibilities for ownership of information (data)&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;and information systems. Ensure that owners classify information and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;systems and protect them in line with their classification.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Implement a consistent management approach for enterprise governance requirements to be met, covering governance components such as&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;management processes; organizational structures; roles and responsibilities; reliable and repeatable activities; information items; policies and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;procedures; skills and competencies; culture and behavior; and services, infrastructure and applications.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As stakeholder of the company, I want to have for any kind of processed data and information system a clear owner in charge, so that there is somebody feeling responsible and acts in a risk mitigating manner.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="sbHoc3gWJixWeE4EDV6L-1" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-3" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="sbHoc3gWJixWeE4EDV6L-1" target="FFkF1W79zcPs98VZCzmz-2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5732.5" y="3580" as="sourcePoint" />
            <mxPoint x="6025.5" y="3560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-7" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM05.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Monitor stakeholder engagement." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="3010" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3750" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-8" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Monitor stakeholder engagement levels and the effectiveness of&lt;/div&gt;&lt;div&gt;stakeholder communication. Assess mechanisms for ensuring accuracy,&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;reliability and effectiveness, and ascertain whether the requirements of&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;different stakeholders in terms of reporting and communication are met.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that stakeholders are supportive of the I&amp;amp;T strategy and road map, communication to stakeholders is effective and timely, and the basis for&amp;nbsp;reporting is established to increase performance. Identify areas for improvement, and confirm that I&amp;amp;T-related objectives and strategies are in line&amp;nbsp;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;with the enterprise’s strategy.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As stakeholder of the company, I want to have engagement mechanisms established and monitored, so that the quality of the reporting on project activities is continuously improved.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="oq3tbu96vJauZoKgjfeR-7" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-10" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" parent="1" source="oq3tbu96vJauZoKgjfeR-7" target="FFkF1W79zcPs98VZCzmz-2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5732.5" y="3530" as="sourcePoint" />
            <mxPoint x="6025.5" y="3560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-9" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="oq3tbu96vJauZoKgjfeR-2" target="VOTrehMlLt_2pqgxl_0n-1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5380" y="2100" as="sourcePoint" />
            <mxPoint x="5870" y="2110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-2" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM05.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Direct stakeholder engagement, communication and reporting." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430" y="1950" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3140" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-3" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Ensure the establishment of effective stakeholder involvement,&lt;/div&gt;&lt;div&gt;communication and reporting, including mechanisms for ensuring the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;quality and completeness of information, overseeing mandatory reporting,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;and creating a communication strategy for stakeholders.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Ensure that stakeholders are supportive of the I&amp;amp;T strategy and road map, communication to stakeholders is effective and timely, and the basis for&amp;nbsp;reporting is established to increase performance. Identify areas for improvement, and confirm that I&amp;amp;T-related objectives and strategies are in line&amp;nbsp;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;with the enterprise’s strategy.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As stakeholder of the company, I want to have engagement, communication and reporting mechanisms established, so that effective and timely reporting of the projects activities is guaranteed in an adequate quality.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: EDM05.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="oq3tbu96vJauZoKgjfeR-2" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-4" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - EDM05.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Evaluate stakeholder engagement and reporting requirements." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5070" y="1950" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="3370" width="360" height="390" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-5" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Continually examine and evaluate current and future requirements for&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;stakeholder engagement and reporting (including reporting mandated&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;by regulatory requirements), and communication to other stakeholders.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Establish principles for engaging and communicating with stakeholders.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;Ensure that stakeholders are supportive of the I&amp;amp;T strategy and road map, communication to stakeholders is effective and timely, and the basis for&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;reporting is established to increase performance. Identify areas for improvement, and confirm that I&amp;amp;T-related objectives and strategies are in line&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;with the enterprise’s strategy.&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As stakeholder of the company, I want to have engagement and reporting requirements established, so that effective and timely reporting of the projects activities is guaranteed.&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;&lt;br&gt;Direct Successor&lt;/u&gt;: EDM05.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="oq3tbu96vJauZoKgjfeR-4" vertex="1">
          <mxGeometry y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="oq3tbu96vJauZoKgjfeR-6" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" parent="1" source="oq3tbu96vJauZoKgjfeR-4" target="oq3tbu96vJauZoKgjfeR-2" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5370" y="1950" as="sourcePoint" />
            <mxPoint x="5430" y="1950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VOTrehMlLt_2pqgxl_0n-1" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;Epic&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="6020" y="1950" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="FFkF1W79zcPs98VZCzmz-2" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;Capability&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="6015" y="3520" width="295" height="60" as="geometry" />
        </mxCell>
        <mxCell id="FFkF1W79zcPs98VZCzmz-3" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;Feature&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="6042.5" y="4680" width="295" height="60" as="geometry" />
        </mxCell>
        <mxCell id="FFkF1W79zcPs98VZCzmz-4" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;Story&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="6042.5" y="5240" width="295" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tx83OqXuTMVFXYHioZqO-1" value="&lt;ul&gt;&lt;li&gt;Features are created by the product manager for an agile release train (ART)&lt;/li&gt;&lt;li&gt;Features get broken down into stories by agile teams at Programme Increment (PI) planning events&lt;/li&gt;&lt;li&gt;Features must be small enough to be delivered by a single ART&lt;/li&gt;&lt;li&gt;Format&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Phrase - brief description&lt;/li&gt;&lt;li&gt;Benefits hypothesis&lt;/li&gt;&lt;li&gt;Acceptance criteria&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="6010" y="4760" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="tx83OqXuTMVFXYHioZqO-2" value="&lt;ul&gt;&lt;li&gt;Stories are created by the agile team who are going to do the work&lt;/li&gt;&lt;li&gt;product owner has content authority&lt;/li&gt;&lt;li&gt;must fit into a single iteration&lt;/li&gt;&lt;li&gt;who? what? and why?&lt;/li&gt;&lt;li&gt;As a &amp;lt;user&amp;gt; I want &amp;lt;function&amp;gt; so that &amp;lt;purpose&amp;gt;&lt;/li&gt;&lt;li&gt;Iteration = Sprint - typically 1-2 weeks&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="6010" y="5320" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tx83OqXuTMVFXYHioZqO-3" value="&lt;ul&gt;&lt;li&gt;Capabilities are created by the solution manager for a solution train&lt;/li&gt;&lt;li&gt;part of the solution backlog where the capabilities are prioritized by the solution manager&lt;/li&gt;&lt;li&gt;capabilities are items that are too big to be delivered in a single programm increment (PI) by a single ART&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Format&lt;/li&gt;&lt;ul style=&quot;border-color: var(--border-color);&quot;&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Phrase - brief description&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Benefits hypothesis&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Acceptance criteria&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="5987.5" y="3600" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="tx83OqXuTMVFXYHioZqO-4" value="&lt;ul&gt;&lt;li&gt;Epic is a sizable initiative that is delivered by an agile release train, solution train or multiple solution trains&lt;/li&gt;&lt;li&gt;Epic has an Epic Owner who is most likely a business owner or product professional&lt;/li&gt;&lt;li&gt;Programm epic&lt;/li&gt;&lt;ul&gt;&lt;li&gt;delivered by a single ART&lt;/li&gt;&lt;li&gt;more than one Programm Increment to do this&lt;/li&gt;&lt;li&gt;business impact below the Portfolio Epic&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Solution epic&lt;/li&gt;&lt;ul&gt;&lt;li&gt;delivered by a single solution train&lt;/li&gt;&lt;li&gt;more than one Programm Increment to do this&lt;/li&gt;&lt;li&gt;business impact below the Portfolio Epic&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Portfolio epic&lt;/li&gt;&lt;ul&gt;&lt;li&gt;requires more than one solution train&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Format&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Name&lt;/li&gt;&lt;li&gt;Epic Owner&lt;/li&gt;&lt;li&gt;Description&lt;/li&gt;&lt;li&gt;Business Outcomes&lt;/li&gt;&lt;li&gt;Leading indicators&lt;/li&gt;&lt;li&gt;MVP&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;Source:&amp;nbsp;&lt;/div&gt;&lt;a href=&quot;https://agility.im/frequent-agile-question/what-are-the-stories-features-capabilities-and-epics-in-safe/&quot;&gt;What are the stories, features, capabilities, and epics in SAFe? - Agility in Mind&lt;/a&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="5995" y="2040" width="350" height="400" as="geometry" />
        </mxCell>
