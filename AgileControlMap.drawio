26lt%3Bbr%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20background-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BEnabler%20Story%3A%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BAs%20management%20of%20the%20enterprise%2C%20want%20agile%20solution%20development%20projects%20to%20contribute%20to%20a%20well%20established%20knowledge%20management%20environment%2C%20in%20order%20to%20maintain%20solution%2Fproduct%2Fproject%20knowledge%20in%20a%20manner%20that%20fits%20to%20the%20enterprise.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3B%26lt%3Bu%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%26quot%3B%26gt%3BDirect%20Successor%26lt%3B%2Fu%26gt%3B%3A%20Knowledge%20management%20(3.2.2)%26lt%3B%2Ffont%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3B%22%20vertex%3D%221%22%20parent%3D%222%22%3E%3CmxGeometry%20y%3D%2260%22%20width%3D%22360%22%20height%3D%22350%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%224%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%26amp%3Bnbsp%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20font-weight%3A%20400%3B%26quot%3B%26gt%3BKnowledge%20management%20(3.2.2)%26lt%3B%2Fi%26gt%3B%26lt%3Bbr%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20On-demand%20information%20discovery%22%20style%3D%22swimlane%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BstartSize%3D60%3BfillColor%3D%23E1D5E7%3BstrokeColor%3D%23A680B8%3B%22%20vertex%3D%221%22%20collapsed%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%225433%22%20y%3D%221990%22%20width%3D%22300%22%20height%3D%2260%22%20as%3D%22geometry%22%3E%3CmxRectangle%20x%3D%225073%22%20y%3D%221720%22%20width%3D%22360%22%20height%3D%22410%22%20as%3D%22alternateBounds%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%225%22%20value%3D%22%26lt%3Bb%26gt%3BControl%20Description%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Registration%20of%20information%20request%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Research%20and%20data%20collection%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Information%20processing%20and%20presentation%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Information%20acceptance%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Knowledge%20integration%20and%20review%26lt%3B%2Fdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BControl%20Objective%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3BThe%20purpose%20of%20the%20knowledge%20management%20practice%20is%20to%20maintain%20and%20improve%20the%20effective%2C%20efficient%2C%20and%20convenient%20use%20of%20information%20and%20knowledge%20across%20the%20organization.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bb%26gt%3BEnabler%20Story%3A%26lt%3B%2Fb%26gt%3B%26lt%3Bbr%26gt%3BAs%20management%20of%20the%20enterprise%2C%20I%20want%20agile%20solution%20development%20projects%20to%20follow%20and%20apply%20on-demand%20information%20discovery%20processes%20to%20be%20established%2C%20in%20order%20to%20explore%20and%20research%20new%20information%20in%20an%20adequate%20quality.%26lt%3Bbr%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3Bfont%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3B%26lt%3Bu%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%26quot%3B%26gt%3BDirect%20Successor%26lt%3B%2Fu%26gt%3B%3A%26amp%3Bnbsp%3B%26lt%3B%2Ffont%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3BKnowledge%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bfont-size%3A%2010px%3B%26quot%3B%26gt%3Bmanagement%20(3.2.3)%26lt%3B%2Fspan%26gt%3B%22%20style%3D%22rounded%3D0%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3B%22%20vertex%3D%221%22%20parent%3D%224%22%3E%3CmxGeometry%20y%3D%2260%22%20width%3D%22360%22%20height%3D%22350%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%226%22%20value%3D%22%22%20style%3D%22endArrow%3Dclassic%3Bhtml%3D1%3Brounded%3D0%3BentryX%3D0%3BentryY%3D0%3BentryDx%3D0%3BentryDy%3D0%3BexitX%3D1%3BexitY%3D0%3BexitDx%3D0%3BexitDy%3D0%3B%22%20edge%3D%221%22%20source%3D%222%22%20target%3D%224%22%20parent%3D%221%22%3E%3CmxGeometry%20width%3D%2250%22%20height%3D%2250%22%20relative%3D%221%22%20as%3D%22geometry%22%3E%3CmxPoint%20x%3D%225023%22%20y%3D%222000%22%20as%3D%22sourcePoint%22%2F%3E%3CmxPoint%20x%3D%225083%22%20y%3D%222000%22%20as%3D%22targetPoint%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;management (3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Strategy generation and continual development" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430.5" y="2350" width="300" height="60" as="geometry">
            <mxRectangle x="5071.75" y="2350" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nVK2YNMN3wv4ctxS4OYY-11" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Strategic assessment&lt;/div&gt;&lt;div&gt;- Strategy planning&lt;/div&gt;&lt;div&gt;- Strategy discussion and approval&lt;/div&gt;&lt;div&gt;- Strategy communication and implementation&lt;/div&gt;&lt;div&gt;- Strategy review&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the strategy management practice is to formulate the goals of the organization and adopt the courses of action and allocation of resources necessary for achieving the goals. Strategy management establishes the organization&#39;s direction, focuses effort, defines or clarifies the organization&#39;s priorities, and provides consistency or guidance in response to the environment.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, want agile solution development projects to follow and enrich the organization&#39;s strategy, in order to assure meeting the organization&#39;s goals.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Strategy management (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="nVK2YNMN3wv4ctxS4OYY-10" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-3" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Strategy management&lt;/i&gt;&amp;nbsp;(3.2.2)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Ad hoc strategic decision-making" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5430.5" y="7730" width="300" height="60" as="geometry">
            <mxRectangle x="5410" y="8160" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-4" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Detection of a strategic exception&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Situational orientation and assessment&lt;/div&gt;&lt;div&gt;- Discussing and agreeing decision&lt;/div&gt;&lt;div&gt;- Decisions communication and implementation&lt;/div&gt;&lt;div&gt;- Review&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the strategy management practice is to formulate the goals of the organization and adopt the courses of action and allocation of resources necessary for achieving those goals. Strategy management establishes the organization&#39;s direction, focuses effort, defines or clarifies the organization&#39;s priorities, and provides consistency or guidance in response to the environment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to identify strategic exception, assess those, derive sufficient alternatives and communicate them, in order to keep the strategy alive.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="UwG0B5D9gC1XuE7l1oR9-3" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.iconpacks.net/icons/2/free-check-icon-3278-thumb.png;" parent="1" vertex="1">
          <mxGeometry x="8010" y="1228" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-6" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Supplier management&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&amp;nbsp;(3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Managing a common approach to supplier management" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5431.75" y="2440" width="300" height="60" as="geometry">
            <mxRectangle x="5070.5" y="2530" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-7" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Develop and agree the sourcing strategy&lt;/div&gt;&lt;div&gt;- Develop and agree the supplier management procedures&lt;/div&gt;&lt;div&gt;- Communicate and embed the sourcing strategy and procedures&lt;/div&gt;&lt;div&gt;- Review and adjust the sourcing strategy and procedures&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the supplier management practice is to ensure that the organization&#39;s suppliers and their performances are managed appropriately to support the seamless provision of quality products and services.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to follow the organization&#39;s approach to manage suppliers, in order to align with the overall enterprise framework or at least follow similarly diligent processes.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Supplier management (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="UwG0B5D9gC1XuE7l1oR9-6" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-8" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Supplier management&lt;/i&gt;&amp;nbsp;(3.2.2)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Managing supplier journeys" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5431.75" y="5640" width="300" height="60" as="geometry">
            <mxRectangle x="5431.75" y="5640" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-9" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Identifying available suppliers&lt;/div&gt;&lt;div&gt;- Engaging with suppliers and communicating demand&lt;/div&gt;&lt;div&gt;- Evaluating and selecting suppliers&lt;/div&gt;&lt;div&gt;- Contracting suppliers&lt;/div&gt;&lt;div&gt;- On / offboarding suppliers&lt;/div&gt;&lt;div&gt;- Managing consumption and monitoring supplier performance&lt;/div&gt;&lt;div&gt;- Assessing and reviewing suppliers&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the supplier management practice is to ensure that the organization&#39;s suppliers and their performances are managed appropriately to support the seamless provision of quality products and services.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to manage their suppliers on a continuous basis in a sufficient manner, in order to manage their performance.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="UwG0B5D9gC1XuE7l1oR9-8" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-10" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.iconpacks.net/icons/2/free-check-icon-3278-thumb.png;" parent="1" vertex="1">
          <mxGeometry x="8010" y="1270" width="42" height="42" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-12" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Workforce and talent management&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&amp;nbsp;(3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Organizational planning" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="4711.75" y="5730" width="300" height="60" as="geometry">
            <mxRectangle x="5428" y="2630" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-13" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Strategic analysis&lt;/div&gt;&lt;div&gt;- Service value chain analysis&lt;/div&gt;&lt;div&gt;- Organizational design&lt;/div&gt;&lt;div&gt;- Initiating and monitoring organizational changes&lt;/div&gt;&lt;div&gt;- Organization monitoring and review&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the workforce and talent management practice is to ensure that the organization has the right people, with the appropriate skills and knowledge, in the correct roles to support ist business objectives.&amp;nbsp;&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to plan organizational changes caused by the project in line with the enterprise&#39;s practices, in order to align with the enterprise&#39;s framework.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Workforce and talent management (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="UwG0B5D9gC1XuE7l1oR9-12" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-14" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Workforce and talent&amp;nbsp;&lt;/i&gt;&lt;i&gt;management&lt;/i&gt;&amp;nbsp;(3.2.2)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Employees&#39; journey management" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5071.75" y="5730" width="300" height="60" as="geometry">
            <mxRectangle x="5071.75" y="5730" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-15" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Segment the workforce and identify the employee journey model&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Verify and adjust the employee journey model&lt;/div&gt;&lt;div&gt;- Follow the model&lt;/div&gt;&lt;div&gt;- Manage exceptions&lt;/div&gt;&lt;div&gt;- Review the journey&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the workforce and talent management practice is to ensure that the organization has the right people, with the appropriate skills and knowledge, in the correct roles to support ist business objectives.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to manage the employee journey within the scope of the project in line with enterprise&#39;s practices, in order create a similar experience for the entire workforce of the enterprise.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Workforce and talent management (3.2.3)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="UwG0B5D9gC1XuE7l1oR9-14" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-16" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Workforce and talent&amp;nbsp;&lt;/i&gt;&lt;i&gt;management&lt;/i&gt;&amp;nbsp;(3.2.3)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Talent management" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5431.75" y="5730" width="300" height="60" as="geometry">
            <mxRectangle x="5431.75" y="5730" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UwG0B5D9gC1XuE7l1oR9-17" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Defining a competency vision&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Competency assessment&lt;/div&gt;&lt;div&gt;- Planning development and optimization&lt;/div&gt;&lt;div&gt;- Steering the development programme&lt;/div&gt;&lt;div&gt;- Managing exceptions&lt;/div&gt;&lt;div&gt;- Competency development programme review&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the workforce and talent management practice is to ensure that the organization has the right people, with the appropriate skills and knowledge, in the correct roles to support ist business objectives.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to define necessary competencies, plan the development of those and steer them, in order make all necessary competences for the project available.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="UwG0B5D9gC1XuE7l1oR9-16" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
