          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-25" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-34" target="VOTrehMlLt_2pqgxl_0n-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4262.5" y="2980" as="sourcePoint" />
            <mxPoint x="5462.5" y="2910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-26" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-32" target="sbHoc3gWJixWeE4EDV6L-30">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4642.5" y="2980" as="sourcePoint" />
            <mxPoint x="4642.5" y="2930" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-27" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-30" target="sbHoc3gWJixWeE4EDV6L-28">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4652.5" y="2990" as="sourcePoint" />
            <mxPoint x="4712.5" y="2990" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-28" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Define architecture implementation." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5422.5" y="3650" width="300" height="60" as="geometry">
            <mxRectangle x="5070" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-29" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Create a viable implementation and migration plan in alignment with the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;program and project portfolios. Ensure the plan is closely coordinated to&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;deliver value and that the required resources are available to complete&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;the necessary work.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board , I want the agile project team to create a viable implementation and a mitigation plan, in order to put the new architectural design in place.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-28">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-30" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Select opportunities and solutions." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5062.5" y="3650" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-31" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Rationalize the gaps between baseline and target architectures,&lt;/div&gt;&lt;div&gt;accounting for both business and technical perspectives, and logically&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;group them into project work packages. Integrate the project with any&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;related I&amp;amp;T-enabled investment programs to ensure that the architectural&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;initiatives are aligned with and enable these initiatives as part of&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;overall enterprise change. Make this a collaborative effort with key&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;enterprise stakeholders from business and IT to assess the enterprise’s&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;transformation readiness, and identify opportunities, solutions and all&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;implementation constraints.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want the agile project team to evaluate the gap between the current baseline and the target architecture, in order to work on closing the gap during their sprints.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-30">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-32" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Define reference architecture." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4702.5" y="3650" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-33" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;The reference architecture describes the current and target architectures&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;for the business, information, data, application and technology domains.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want the agile project team to describe the target architecture for the business and review the current architecture, so that IT solutions can be build according to the target architecture and the effects of the new developments to the current architecture is evaluated.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-32">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-34" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO03.01&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Develop the enterprise architecture vision." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5422.5" y="2790" width="300" height="60" as="geometry">
            <mxRectangle x="3990" y="3320" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-35" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;The architecture vision provides a first-cut, high-level description of the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;baseline and target architectures, covering the business, information,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;data, application and technology domains. The architecture vision&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;provides the sponsor with a key tool to sell the benefits of the proposed&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;capabilities to stakeholders within the enterprise. The architecture&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;vision describes how the new capabilities (in line with I&amp;amp;T strategy&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;and objectives) will meet enterprise goals and strategic objectives and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;address stakeholder concerns when implemented.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Represent the different building blocks that make up the enterprise and its interrelationships as well as the principles guiding their design and&amp;nbsp;evolution over time, to enable a standard, responsive and efficient delivery of operational and strategic objectives.&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management board, I want the agile project team to develop for their epics an architectural vision, high-level baseline and target architecture, so that the architectural design follows a clear vision.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO03.02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-34">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-38" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-28" target="FFkF1W79zcPs98VZCzmz-2">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5362.5" y="3140" as="sourcePoint" />
            <mxPoint x="5422.5" y="3140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-39" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-42" target="sbHoc3gWJixWeE4EDV6L-40">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="4292.5" y="2890" as="sourcePoint" />
            <mxPoint x="4352.5" y="2890" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-40" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.03&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Create and maintain budgets." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4702.5" y="2880" width="300" height="60" as="geometry">
            <mxRectangle x="4710" y="3410" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-41" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Prepare a budget reflecting investment priorities based on the portfolio&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;of I&amp;amp;T-enabled programs and I&amp;amp;T services.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want a budget which reflects the investment priorities, in order to strategically allocate resources effectively.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO06.04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-40">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-42" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.02&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Prioritize resource allocation." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="4342.5" y="2880" width="300" height="60" as="geometry">
            <mxRectangle x="4350" y="3410" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-43" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Implement a decision-making process to prioritize the allocation of&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;resources and establish rules for discretionary investments by individual&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;business units. Include the potential use of external service providers&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;and consider the buy, develop and rent options.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want the agile project team to implement clear decision-making processes to allocate resources, in order to establish a transparent and traceable process.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO06.03&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-42">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-44" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.04&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Model and allocate costs." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5062.5" y="2880" width="300" height="60" as="geometry">
            <mxRectangle x="5062.5" y="2880" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-45" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Establish and use an I&amp;amp;T costing model based, for example, on the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;service definition. This approach ensures that allocation of costs for&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;services is identifiable, measurable and predictable, and encourages&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;the responsible use of resources, including those provided by service&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;providers. Regularly review and benchmark the cost/chargeback model&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;to maintain its relevance and appropriateness for evolving business and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;IT activities.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want costs to be clearly assigned, in order to make costs identifiable, measureable and rpedictable.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: APO06.05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-44">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-46" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;COBIT 2019 - APO06.05&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Manage costs." style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="5422.5" y="2880" width="300" height="60" as="geometry">
            <mxRectangle x="5430" y="3410" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-47" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;Implement a cost management process that compares actual costs&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;against budget. Costs should be monitored and reported. Deviations&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;from budget should be identified in a timely manner and their impact on&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;enterprise processes and services assessed.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;Foster a partnership between IT and enterprise stakeholders to enable the effective and efficient use of I&amp;amp;T-related resources and provide transparency and accountability of the cost and business value of solutions and services. Enable the enterprise to make informed decisions regarding the use of I&amp;amp;T solutions and services.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want to be well informed on the budget consumption and any deviations, in order to be able to react on deviations.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="sbHoc3gWJixWeE4EDV6L-46">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-48" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-40" target="sbHoc3gWJixWeE4EDV6L-44">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5002.5" y="2880" as="sourcePoint" />
            <mxPoint x="5062.5" y="2880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-49" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-44" target="sbHoc3gWJixWeE4EDV6L-46">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5012.5" y="2890" as="sourcePoint" />
            <mxPoint x="5072.5" y="2890" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sbHoc3gWJixWeE4EDV6L-50" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sbHoc3gWJixWeE4EDV6L-46" target="VOTrehMlLt_2pqgxl_0n-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="5732.5" y="2800" as="sourcePoint" />
