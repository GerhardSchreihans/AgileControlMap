          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-10" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Analyse stakeholder requirements&lt;/div&gt;&lt;div&gt;- Define and agree the service configuration management approach&lt;/div&gt;&lt;div&gt;- Communicate and integrate the service configuration management approach into the organization&#39;s value streams&lt;/div&gt;&lt;div&gt;- Review and adjust the service configuration management approach and procedures&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the service configuration management practice is to ensure that accurate and reliable information about the configuration of services, and the configuration items that support them, is available when and where it is needed.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects be familiar with the service configuration management practice, in order to follow it correctly.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Service configuration management (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-9" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-11" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Service configuration&amp;nbsp;&lt;/i&gt;management (3.2.2)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Capturing, managing, and providing configuration information" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="6550.5" y="7370" width="300" height="60" as="geometry">
            <mxRectangle x="5070.5" y="2620" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-12" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Analyse resources and identify CIs&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Confirm a CI model&lt;/div&gt;&lt;div&gt;- Follow the CI model&lt;/div&gt;&lt;div&gt;- Manage exceptions&lt;/div&gt;&lt;div&gt;- Review the CI model&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the service configuration management practice is to ensure that accurate and reliable information about the configuration of services, and the configuration items that support them, is available when and where it is needed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to keep the configuration information current, in order to assure that all service management processes have up-to-date information.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Service configuration&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;management (3.2.3)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-11" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-13" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Service configuration&amp;nbsp;&lt;/i&gt;management (3.2.3)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Verifying configuration data" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="6910.5" y="7370" width="300" height="60" as="geometry">
            <mxRectangle x="5430.5" y="2620" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-14" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Identify a CI model&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Verify configuration data&lt;/div&gt;&lt;div&gt;- Review the verification output&lt;/div&gt;&lt;div&gt;- Define and implement corrective actions&lt;/div&gt;&lt;div&gt;- Compose and communicate a CMDB verification report&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the service configuration management practice is to ensure that accurate and reliable information about the configuration of services, and the configuration items that support them, is available when and where it is needed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects the be aware that verification are on-going or even have to be performed by them, in order to assure accurate information within the CMDB.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-13" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-15" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.iconpacks.net/icons/2/free-check-icon-3278-thumb.png;" parent="1" vertex="1">
          <mxGeometry x="8500" y="1080" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-16" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Service continuity management&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&amp;nbsp;(3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Governance of service continuity management" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5431.75" y="2710" width="300" height="60" as="geometry">
            <mxRectangle x="3991.75" y="6180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-17" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Scope definition&lt;/div&gt;&lt;div&gt;- Policy setting&lt;/div&gt;&lt;div&gt;- Awareness and exercise programme development&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the service continuity management practice is to ensure that the availability and performance of a service are maintained at sufficient levels in case of a disaster.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to be aware over governance mechanisms regarding service continuity management, in order to consider those aspects already in the development process or at least preliminary to the release.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Service continuity management (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-16" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-18" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Service continuity management&lt;/i&gt;&amp;nbsp;(3.2.2)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Business impact analysis" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5433" y="6180" width="300" height="60" as="geometry">
            <mxRectangle x="4351.75" y="6180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-19" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- VBF identification&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Analysis of the consequences of disruption&lt;/div&gt;&lt;div&gt;- VBF interdependencies&lt;/div&gt;&lt;div&gt;- Determination of the service continuity requirements&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the workforce and talent management practice is to ensure that the organization has the right people, with the appropriate skills and knowledge, in the correct roles to support ist business objectives.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to consider if the developed solution used in a vital business function (VBF), in order to design the solution in a resilient manner.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Service continuity&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;management (3.2.3)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-18" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-20" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Service continuity management&lt;/i&gt;&amp;nbsp;(3.2.3)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Developing and maintaining service continuity plans" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5433" y="8090" width="300" height="60" as="geometry">
            <mxRectangle x="4711.75" y="6180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-21" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Service continuity strategy development&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Service continuity plans development&lt;/div&gt;&lt;div&gt;- Initial testing of service continuity plans&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the workforce and talent management practice is to ensure that the organization has the right people, with the appropriate skills and knowledge, in the correct roles to support ist business objectives.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to consider service continuity plans already in course of the solutions development, in order to have the plans ready when it goes in production.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Service continuity management (3.2.4)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-20" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-22" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Service continuity management&lt;/i&gt;&amp;nbsp;(3.2.4)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Testing service continuity plans" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="6550.5" y="1060" width="300" height="60" as="geometry">
            <mxRectangle x="5073" y="6180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-23" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Performing exercises&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Service continuity audit&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the workforce and talent management practice is to ensure that the organization has the right people, with the appropriate skills and knowledge, in the correct roles to support ist business objectives.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to consider testing already before the final release, in order to have workable continuity procedures in place when the solution goes in production.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;:&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Service continuity&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;management (3.2.5)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-22" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-24" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 -&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i&gt;Service continuity management&lt;/i&gt;&amp;nbsp;(3.2.5)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Response and recovery" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="6910.5" y="1060" width="300" height="60" as="geometry">
            <mxRectangle x="5433" y="6180" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-25" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Invocation&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Executing service continuity plans&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the workforce and talent management practice is to ensure that the organization has the right people, with the appropriate skills and knowledge, in the correct roles to support ist business objectives.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to assure that plans are ready and available when needed, in order to have a workable solution which is executable.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="x0tNCmZjMzLHtTbmIZVQ-24" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="x0tNCmZjMzLHtTbmIZVQ-26" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.iconpacks.net/icons/2/free-check-icon-3278-thumb.png;" parent="1" vertex="1">
          <mxGeometry x="8470" y="1120" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-1" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Service Design&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;(3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Service design planning" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5433" y="6270" width="300" height="60" as="geometry">
            <mxRectangle x="5073" y="6270" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-2" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Service/product environment and requirements analysis&lt;/div&gt;&lt;div&gt;- Service design approach review and development&lt;/div&gt;&lt;div&gt;- Service design model review and development&lt;/div&gt;&lt;div&gt;- Service design instance planning&lt;/div&gt;&lt;div&gt;- Service design plan communication&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the service design practice is to design products and services that are fit for purpose and use, and that can be delivered by the organization and its ecosystem. This includes planning and organizing people, partners and suppliers, information, communication, technology, and practices for new or changed products and services, and the interaction between the organization and its customers.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to apply service design planning practices, in order to develop solutions that integrate seamlessly in the enterprises service model.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Service Design (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="FzpiOMwNagBz9-rqdHPx-1" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-3" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Service Design&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;(3.2.2)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Service design coordination" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5433" y="8180" width="300" height="60" as="geometry">
            <mxRectangle x="5433" y="6270" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-4" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;div&gt;- Identification of applicable design model or plan&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- Planning design activities, resources and capabilities&lt;/div&gt;&lt;div&gt;- Design execution&lt;/div&gt;&lt;div&gt;- Service design review&lt;/div&gt;&lt;br&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the service design practice is to design products and services that are fit for purpose and use, and that can be delivered by the organization and its ecosystem. This includes planning and organizing people, partners and suppliers, information, communication, technology, and practices for new or changed products and services, and the interaction between the organization and its customers.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to apply service design coordination practices, in order to maintain a consistent service design.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: None&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="FzpiOMwNagBz9-rqdHPx-3" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.iconpacks.net/icons/2/free-check-icon-3278-thumb.png;" parent="1" vertex="1">
          <mxGeometry x="8270" y="1168" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-6" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.iconpacks.net/icons/2/free-check-icon-3278-thumb.png;" parent="1" vertex="1">
          <mxGeometry x="8240" y="1208" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-7" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Service Level Management&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&amp;nbsp;(3.2.1)&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;  Management of SLAs" style="swimlane;whiteSpace=wrap;html=1;align=left;startSize=60;fillColor=#E1D5E7;strokeColor=#A680B8;" parent="1" vertex="1" collapsed="1">
          <mxGeometry x="5433" y="8270" width="300" height="60" as="geometry">
            <mxRectangle x="5073" y="6360" width="360" height="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-8" value="&lt;b&gt;Control Description:&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;- Definition of customer requirements&lt;/div&gt;&lt;div&gt;- Viability analysis&lt;/div&gt;&lt;div&gt;- Drafting and SLA&lt;/div&gt;&lt;div&gt;- SLA negotiation&lt;/div&gt;&lt;div&gt;- SLA communication and enablement&lt;/div&gt;&lt;div&gt;- SLA review&lt;/div&gt;&lt;div&gt;- SLA prolongation&lt;/div&gt;&lt;div&gt;- SLA withdrawal&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;Control Objective:&lt;br&gt;&lt;/b&gt;The purpose of the service level management practice is to set clear business-based targets for service levels, and to ensure that delivery of services is properly assed, monitored, and managed against these targets.&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color); background-color: initial;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enabler Story:&lt;/b&gt;&lt;br&gt;As management of the enterprise, I want agile solution development projects to draft and manage SLAs with their service providers according to company standards, in order to assure an adequate quality and manageability of the enterprise&#39;s partners.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Direct Successor&lt;/u&gt;: Service Level Management (3.2.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="FzpiOMwNagBz9-rqdHPx-7" vertex="1">
          <mxGeometry y="60" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="FzpiOMwNagBz9-rqdHPx-9" value="&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;i&gt;ITIL 4 - Service Level&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;border-color: var(--border-color); font-weight: 400;&quot;&gt;&lt;i style=&quot;border-color: var(--border-color);&quot;&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-style: normal; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26lt%3Bspan%20style%3D%26quot%3Bfont-weight%3A%20400%3B%26quot%3B%26gt%3B%26lt%3Bi%26gt%3BITIL%204%20-%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bborder-color%3A%20var(--border-color)%3B%20font-weight%3A%20400%3B%26quot%3B%26gt%3BKnowledge%20management%20(3.2.1)%26lt%3B%2Fi%26gt%3B%26lt%3Bbr%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%20Establishing%20and%20maintaining%20the%20knowledge%20management%20environment%22%20style%3D%22swimlane%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3Balign%3Dleft%3BstartSize%3D60%3BfillColor%3D%23E1D5E7%3BstrokeColor%3D%23A680B8%3B%22%20vertex%3D%221%22%20collapsed%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%225073%22%20y%3D%221990%22%20width%3D%22300%22%20height%3D%2260%22%20as%3D%22geometry%22%3E%3CmxRectangle%20x%3D%224713%22%20y%3D%221720%22%20width%3D%22360%22%20height%3D%22410%22%20as%3D%22alternateBounds%22%2F%3E%3C%2FmxGeometry%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%223%22%20value%3D%22%26lt%3Bb%26gt%3BControl%20Description%3A%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Understand%20current%20culture%20of%20knowledge%20usage%20and%20knowledge%20sharing%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3B-%20Review%20external%20and%20internal%20requirement